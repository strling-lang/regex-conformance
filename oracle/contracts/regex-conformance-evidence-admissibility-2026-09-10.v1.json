{"admissibility_decision_contract":{"decision_inputs":["evidence role","epistemic use","requested conclusion","oracle compatibility","normative strength","semantic scope","immutable provenance","dependency independence","quality eligibility"],"decision_states":["admissible","inadmissible"],"fail_closed":true,"scope_must_be_covered":true,"unknown_or_incomplete_never_elevates":true},"authority_domain_contract":{"deep_dependency_traversal_required":true,"independent_domain_count_rule":"Count unique authority domains over all reachable expected-basis dependencies after collapsing wrappers and transformed mirrors to their upstream semantic authority.","shared_upstream_is_shared_authority":true,"wrapper_independence_forbidden":true},"authority_scope":"Prospective evidence-role and epistemic-use admissibility for exact semantic requirements. No profile applicability decision, discrepancy adjudication, waiver, claim issuance, observation rewrite, or production vector is created here.","contract_digest_sha256":"37bac8b2b69a906d1008fd2cb21cb38bc81cca3a5f952cc0ad394475318bbe02","contract_id":"rcid:v1:trust-policy-revision:h:jcs-sha256-v1:a6414c91a3a1fe0e6b24594ad4217c911739c520e417640b09a94362a423ef39","contract_version":"1.0.0","derivation":{"derivation_class":"manual-decision","derivation_id":"rcid:v1:assertion-derivation:u7:01a08d9e-ab75-762b-8a10-90db25ccb8fb","derivation_revision_id":"rcid:v1:assertion-derivation-revision:h:jcs-sha256-v1:8b15d22cdd8ad1853cdc390ad87ebc908a6d0cc239ba95765d9a594a2d53b8d5"},"effective_on":"2026-09-10","epistemic_uses":[{"admissible_evidence_roles":["normative-source-evidence"],"correctness_establishing":true,"epistemic_use":"establish-normative-expectation","independence_required":true,"meaning":"Establish the exact externally normative expectation selected by applicable source language.","permitted_conclusions":["normative-required-expectation","normative-prohibited-expectation","normative-permission","normative-optionality","normative-condi