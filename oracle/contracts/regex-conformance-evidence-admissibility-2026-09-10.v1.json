n-ambiguous","implementation-documentation-incomplete"]},{"admissible_evidence_roles":["historical-empirical-evidence"],"correctness_establishing":false,"epistemic_use":"establish-historical-fact","independence_required":false,"meaning":"Establish an exact historical empirical fact, never a normative expectation.","permitted_conclusions":["historical-fact-recorded","historical-behavior-reproduced","historical-behavior-diverged"]},{"admissible_evidence_roles":["historical-empirical-evidence","characterization-only-evidence"],"correctness_establishing":false,"epistemic_use":"establish-characterization","independence_required":false,"meaning":"Record characterization, descriptive differential, or research-gap evidence.","permitted_conclusions":["characterization-recorded","descriptive-differential","research-gap-recorded"]},{"admissible_evidence_roles":["normative-source-evidence","formal-derivation-evidence","authoritative-data-derived-evidence","relational-metamorphic-evidence","family-relative-reference-evidence","implementation-documentation-evidence","historical-empirical-evidence","characterization-only-evidence"],"correctness_establishing":false,"epistemic_use":"support-discrepancy-investigation","independence_required":false,"meaning":"Provide independently preserved context for later discrepancy investigation without adjudicating it.","permitted_conclusions":["discrepancy-investigation-input"]},{"admissible_evidence_roles":["normative-source-evidence","formal-derivation-evidence","authoritative-data-derived-evidence","relational-metamorphic-evidence","family-relative-reference-evidence","implementation-documentation-evidence","historical-empirical-evidence","characterization-only-evidence"],"correctness_establishing":false,"epistemic_use":"support-research-revision","independence_required":false,"meaning":"Motivate later researched revision without becoming that revision's authority by itself.","permitted_conclusions":["research-revision-input"]}],"evidence_roles":[{"conclusion_boundary":"Only mandatory, prohibitive, permissive, optional, or conditional normative language can establish its corresponding scoped expectation; informative, ambiguous, unspecified, or silent material cannot.","epistemic_function":"Preserves an exact proposition from an explicitly normative source for its exact governed scope.","evidence_role":"normative-source-evidence","expectation_bearing":true,"oracle_class":"O1","permitted_conclusions":["normative-required-expectation","normative-prohibited-expectation","normative-permission","normative-optionality","normative-conditional-expectation","normative-ambiguity-recorded","normative-under-specification-recorded","discrepancy-investigation-input","research-revision-input"],"potentially_admitted_uses":["establish-normative-expectation","support-discrepancy-investigation","support-research-revision"],"required_provenance_fields":["proposition_revision_id","retrieval_snapshot_id","semantic_authority","source_identity","source_revision","source_snapshot_digest_sha256","stable_locator"]},{"conclusion_boundary":"A program output is formal evidence only when the model, assumptions, inputs, subset, method, output, and independent check are pinned and independent of the evaluated target.","epistemic_function":"Preserves an independently checkable result within an exact formal model and admitted semantic subset.","evidence_role":"formal-derivation-evidence","expectation_bearing":true,"oracle_class":"O2","permitted_conclusions":["formal-model-expectation","formal-model-satisfied","formal-model-violated","discrepancy-investigation-input","research-revision-input"],"potentially_admitted_uses":["establish-formal-model-expectation","support-discrepancy-investigation","support-research-revision"],"required_provenance_fields":["admitted_semantic_subset","assumptions","derivation_method_identity","derivation_method_version","derivation_output_digest_sha256","formal_model_identity","formal_model_version","independent_checker_identities","input_identities"]},{"conclusion_boundary":"Neither a data table nor an algorithm alone establishes regex semantics; pinned data, an independent semantic rule, and the deterministic derivation are all required.","epistemic_function":"Combines pinned authoritative data with an established semantic rule and deterministic derivation.","evidence_role":"authoritative-data-derived-evidence","expectation_bearing":true,"oracle_class":"O3","permitted_conclusions":["data-scoped-expectation","data-scoped-agreement","data-scoped-disagreement","discrepancy-investigation-input","research-revision-input"],"potentially_admitted_uses":["establish-data-scoped-expectation","support-discrepancy-investigation","support-research-revision"],"required_provenance_fields":["algorithm_identity","algorithm_version","dataset_digest_sha256","dataset_identity","dataset_version","derivation_output_digest_sha256","semantic_rule_revision_id"]},{"conclusion_boundary":"Violation of a valid necessary relation may establish a relational defect; satisfaction establishes only the relation and never full correctness.","epistemic_function":"Evaluates a necessary relation among exact executions of the same applicable profile.","evidence_role":"relational-metamorphic-evidence","expectation_bearing":false,"oracle_class":"O4","permitted_conclusions":["relation-violation-defect","relation-satisfied-only","discrepancy-investigation-input","research-revision-input"],"potentially_admitted_uses":["evaluate-metamorphic-relation","support-discrepancy-investigation","support-research-revision"],"required_provenance_fields":["directionality","execution_ids","gating_assumptions","relation_identity","relation_semantics","relation_version","satisfaction_establishes_full_correctness","violation_sufficient_for_relational_defect"]},{"conclusion_boundary":"A designated reference is family-relative evidence, not independent correctness authority and never universal truth.","epistemic_function":"Compares exact configurations, backends, or releases within one explicitly designated implementation family.","evidence_role":"family-relative-reference-evidence","expectation_bearing":false,"oracle_class":"O5","permitted_conclusions":["family-relative-equivalence","family-relative-divergence","family-relative-regression","family-relative-change","discrepancy-investigation-input","research-revision-input"],"potentially_admitted_uses":["establish-family-relative-comparison","support-discrepancy-investigation","support-research-revision"],"required_provenance_fields":["carve_outs","compared_profile_ids","comparison_scope","designation_revision_id","profile_family_id","reference_profile_id"]},{"conclusion_boundary":"The evidence may establish conformance to the implementation's own documentation, never silently an external normative requirement.","epistemic_function":"Preserves what an exact implementation revision documents about itself.","evidence_role":"implementation-documentation-evidence","expectation_bearing":true,"oracle_class":"O6","permitted_conclusions":["implementation-documented-expectation","implementation-documentation-ambiguous","implementation-documentation-incomplete","discrepancy-investigation-input","research-revision-input"],"potentially_admitted_uses":["establish-implementation-documentation-expectation","support-discrepancy-investigation","support-research-revision"],"required_provenance_fields":["ambiguity_status","completeness_status","documentation_identity","documentation_revision","documentation_snapshot_digest_sha256","implementation_scope_id","stable_locator"]},{"conclusion_boundary":"Age, stability, and reproduction establish historical fact only; they cannot bootstrap normative truth.","epistemic_function":"Preserves what a specific historical profile did and whether exact reproduction agreed.","evidence_role":"historical-empirical-evidence","expectation_bearing":false,"oracle_class":"O7","permitted_conclusions":["historical-fact-recorded","historical-behavior-reproduced","historical-behavior-diverged","characterization-recorded","discrepancy-investigation-input","research-revision-input"],"potentially_admitted_uses":["establish-historical-fact","establish-characterization","support-discrepancy-investigation","support-research-revision"],"required_provenance_fields":["evidence_manifest_ids","historical_profile_ids","historical_scope","observation_ids","observed_interval","reproduction_record_ids"]},{"conclusion_boundary":"Even perfectly reproduced characterization cannot create an expected result or conformance verdict.","epistemic_function":"Preserves observations, differentials, probes, or research gaps when no admissible correctness authority exists.","evidence_role":"characterization-only-evidence","expectation_bearing":false,"oracle_class":"O8","permitted_conclusions":["characterization-recorded","descriptive-differential","research-gap-recorded","discrepancy-investigation-input","research-revision-input"],"potentially_admitted_uses":["establish-characterization","support-discrepancy-investigation","support-research-revision"],"required_provenance_fields":["characterization_scope","observation_or_probe_ids","reason_no_expectation","research_gap_id","searched_authority_ids"]}],"immutable_provenance_contract":{"content_digest_required":true,"exact_version_required":true,"knowledge_projection_rule":"A projection is operationally authoritative only for the exact frozen campaign binding; source meaning remains owned by its exact Knowledge identities and revisions.","mutable_aliases_forbidden":["current","head","latest","main","master","tip"],"stable_locator_required_when_source_based":true},"knowledge_authority":{"artifact_id":"rcid:v1:ontology-snapshot:h:jcs-sha256-v1:4c9afcd3ea350a6f6c0a429d96fd6b10ca7d142300ce9a39e94809a1f383899e","digest_sha256":"e2c99c582ad9c8f2875060f9cb9d3ec0da8057f554ac09477f8e07b96da30b05","path":"semantic-corpus/snapshots/regex-semantic-features-2026-09-08.v4.json"},"normative_stre