{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/oracle-foundation-contract.schema.json",
  "title": "Oracle foundation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "effective_on", "authority_scope", "semantic_requirement_authority", "oracle_classes", "resolution_states", "dependency_contract", "circularity_guards", "selection_and_conflict", "promotion_contract", "campaign_freeze_contract", "requirement_capability_compatibility", "derivation", "contract_id", "contract_digest_sha256"],
  "properties": {
    "schema_version": {"const": "oracle-foundation-contract.v1"},
    "contract_version": {"const": "1.0.0"},
    "effective_on": {"type": "string", "format": "date"},
    "authority_scope": {"type": "string", "minLength": 1},
    "semantic_requirement_authority": {"$ref": "#/$defs/requirementAuthority"},
    "oracle_classes": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/oracleClass"}},
    "resolution_states": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["state", "meaning"], "properties": {"state": {"$ref": "#/$defs/resolutionState"}, "meaning": {"type": "string", "minLength": 1}}}},
    "dependency_contract": {"type": "object", "additionalProperties": false, "required": ["dependency_kinds", "semantic_roles", "authority_domain_rule", "traversal_rule"], "properties": {"dependency_kinds": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}}, "semantic_roles": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}}, "authority_domain_rule": {"type": "string", "minLength": 1}, "traversal_rule": {"type": "string", "minLength": 1}}},
    "circularity_guards": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["guard_id", "machine_rule", "statement", "mandatory"], "properties": {"guard_id": {"pattern": "^G[1-8]$", "type": "string"}, "machine_rule": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "mandatory": {"const": true}}}},
    "selection_and_conflict": {"type": "object", "additionalProperties": false, "required": ["class_precedence", "numeric_rank_forbidden", "selection_rule", "compatible_composition_rule", "conflict_rule", "future_adjudication_required"], "properties": {"class_precedence": {"const": "none"}, "numeric_rank_forbidden": {"const": true}, "selection_rule": {"type": "string"}, "compatible_composition_rule": {"type": "string"}, "conflict_rule": {"type": "string"}, "future_adjudication_required": {"const": true}}},
    "promotion_contract": {"type": "object", "additionalProperties": false, "required": ["observation_alone_sufficient", "required_fields", "independence_rule"], "properties": {"observation_alone_sufficient": {"const": false}, "required_fields": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}}, "independence_rule": {"type": "string"}}},
    "campaign_freeze_contract": {"type": "object", "additionalProperties": false, "required": ["exact_oracle_ids_and_digests_required", "exact_contract_id_and_digest_required", "mutable_latest_alias_forbidden", "later_revision_mutates_historical_binding"], "properties": {"exact_oracle_ids_and_digests_required": {"const": true}, "exact_contract_id_and_digest_required": {"const": true}, "mutable_latest_alias_forbidden": {"const": true}, "later_revision_mutates_historical_binding": {"const": false}}},
    "requirement_capability_compatibility": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["expected_oracle_capability", "admissible_oracle_classes"], "properties": {"expected_oracle_capability": {"enum": ["normative-expected-outcome", "profile-documentation-outcome", "relational-comparison", "characterization-record"]}, "admissible_oracle_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^O[1-8]$", "type": "string"}}}}},
    "derivation": {"$ref": "#/$defs/derivation"},
    "contract_id": {"pattern": "^rcid:v1:trust-policy-revision:h:jcs-sha256-v1:[0-9a-f]{64}$", "type": "string"},
    "contract_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rcid": {"type": "string", "pattern": "^rcid:v1:"},
    "resolutionState": {"enum": ["oracle-established", "oracle-inapplicable", "expectation-ambiguous", "expectation-under-specified", "conflicting-authoritative-expectations", "oracle-inputs-unavailable", "characterization-only"]},
    "requirementAuthority": {"type": "object", "additionalProperties": false, "required": ["path", "artifact_id", "digest_sha256", "requirement_count"], "properties": {"path": {"type": "string"}, "artifact_id": {"$ref": "#/$defs/rcid"}, "digest_sha256": {"$ref": "#/$defs/sha256"}, "requirement_count": {"const": 3378}}},
    "oracleClass": {"type": "object", "additionalProperties": false, "required": ["oracle_class", "name", "epistemic_function", "scope_kind", "required_provenance_fields", "permitted_judgments", "may_establish_conventional_expected_result", "conclusion_boundary"], "properties": {"oracle_class": {"pattern": "^O[1-8]$", "type": "string"}, "name": {"type": "string", "minLength": 1}, "epistemic_function": {"type": "string", "minLength": 1}, "scope_kind": {"type": "string", "minLength": 1}, "required_provenance_fields": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}, "permitted_judgments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "may_establish_conventional_expected_result": {"type": "boolean"}, "conclusion_boundary": {"type": "string", "minLength": 1}}},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["derivation_id", "derivation_revision_id", "derivation_class"], "properties": {"derivation_id": {"$ref": "#/$defs/rcid"}, "derivation_revision_id": {"$ref": "#/$defs/rcid"}, "derivation_class": {"const": "manual-decision"}}}
  }
}
