{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/small-scale-campaign-definition.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "campaign_definition_id", "campaign_id", "base_coordinates_source", "profile_overlay_source", "vector_source", "applicability_source", "classification", "shard_size", "profile_inputs"],
  "properties": {
    "schema_version": {"const": "small-scale-campaign-definition.v1"},
    "campaign_definition_id": {"$ref": "#/$defs/rcid"},
    "campaign_id": {"$ref": "#/$defs/rcid"},
    "base_coordinates_source": {"const": "registries/profiles/vertical-slice-coordinates.v1.json"},
    "profile_overlay_source": {"const": "registries/profiles/small-scale-qualification.v1.json"},
    "vector_source": {"const": "vectors/definitions/small-scale-qualification.v1.json"},
    "applicability_source": {"const": "applicability/policies/small-scale-qualification.v1.json"},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["completion_denominator", "normative_authority", "probe_only", "semantic_authority"],
      "properties": {"completion_denominator": {"const": "development-only"}, "normative_authority": {"const": false}, "probe_only": {"const": true}, "semantic_authority": {"const": false}}
    },
    "shard_size": {"type": "integer", "minimum": 1, "maximum": 1000},
    "profile_inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["selection_key", "dimensions", "options"],
        "properties": {
          "selection_key": {"$ref": "#/$defs/token"},
          "dimensions": {"$ref": "#/$defs/namedValues"},
          "options": {"$ref": "#/$defs/namedValues"}
        }
      }
    }
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "rcid": {"type": "string", "pattern": "^rcid:v1:[a-z0-9]+(?:-[a-z0-9]+)*:(?:u7:[0-9a-f-]{36}|h:jcs-sha256-v1:[0-9a-f]{64})$"},
    "namedValues": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {"name": {"$ref": "#/$defs/token"}, "value": {"oneOf": [{"type": "boolean"}, {"type": "integer"}, {"type": "string"}, {"type": "null"}]}}
      }
    }
  }
}
