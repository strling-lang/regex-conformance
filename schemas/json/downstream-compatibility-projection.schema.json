{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/downstream-compatibility-projection.schema.json",
  "title": "Coverage Shard Compatibility Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "coverage_shard_id", "profiles", "projection_digest_sha256", "projection_id", "schema_version", "semantic_snapshot_digest_sha256", "source_revision"],
  "properties": {
    "schema_version": {"const": "downstream-compatibility-projection.v1"},
    "projection_id": {"type": "string", "pattern": "^coverage-shard-[0-9]{4}\\.compatibility\\.v1$"},
    "coverage_shard_id": {"$ref": "#/$defs/shardId"},
    "semantic_snapshot_digest_sha256": {"$ref": "#/$defs/digest"},
    "source_revision": {"$ref": "#/$defs/gitSha"},
    "projection_digest_sha256": {"$ref": "#/$defs/digest"},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from_certified_evidence", "manually_authored_compatibility_truth", "primary_evidence", "website_authority"],
      "properties": {
        "derived_from_certified_evidence": {"const": true},
        "manually_authored_compatibility_truth": {"const": false},
        "primary_evidence": {"const": false},
        "website_authority": {"const": false}
      }
    },
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rcid": {"type": "string", "pattern": "^rcid:v1:[a-z0-9]+(?:-[a-z0-9]+)*:(?:u7:[0-9a-f-]{36}|h:jcs-sha256-v1:[0-9a-f]{64})$"},
    "shardId": {"type": "string", "pattern": "^coverage-shard-[0-9]{4}$"},
    "nullableDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable_obligation_count", "condition", "coordinate_set_digest_sha256", "coverage_state", "credited_obligation_count", "evidence_coordinate_digest_sha256", "evidence_manifest_sha256", "feature_id", "governed_exclusion_digest_sha256", "governed_not_applicable_obligation_count", "limitation_digest_sha256", "operation_id", "outcome"],
      "properties": {
        "feature_id": {"type": "string", "pattern": "^feature\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "operation_id": {"type": "string", "pattern": "^operation\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "outcome": {"enum": ["supported", "unsupported", "conditional", "not-applicable", "unknown"]},
        "coverage_state": {"enum": ["certified", "governed-not-applicable", "certified-unreproducible"]},
        "condition": {"type": ["string", "null"], "minLength": 1},
        "applicable_obligation_count": {"type": "integer", "minimum": 0},
        "credited_obligation_count": {"type": "integer", "minimum": 0},
        "governed_not_applicable_obligation_count": {"type": "integer", "minimum": 0},
        "coordinate_set_digest_sha256": {"$ref": "#/$defs/digest"},
        "evidence_manifest_sha256": {"$ref": "#/$defs/nullableDigest"},
        "evidence_coordinate_digest_sha256": {"$ref": "#/$defs/nullableDigest"},
        "governed_exclusion_digest_sha256": {"$ref": "#/$defs/nullableDigest"},
        "limitation_digest_sha256": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomes", "profile_id", "release_classification", "release_id", "reproducibility_disposition"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/rcid"},
        "release_id": {"$ref": "#/$defs/rcid"},
        "release_classification": {"enum": ["current", "historical"]},
        "reproducibility_disposition": {"enum": ["reproducibly-executable", "explicitly-unreproducible"]},
        "outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcome"}}
      }
    }
  }
}
