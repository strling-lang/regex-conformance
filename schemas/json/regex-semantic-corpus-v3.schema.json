{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/regex-semantic-corpus-v3.schema.json",
  "title": "Expanded researched regex semantic architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "published_on", "status", "authority", "predecessor", "candidate_ledger", "sources", "semantic_facets", "operations", "modifiers", "features", "manifestations", "carried_forward_by_reference", "counts", "snapshot_id", "snapshot_digest_sha256"],
  "properties": {
    "schema_version": {"const": "regex-semantic-corpus.v3"},
    "published_on": {"type": "string", "format": "date"},
    "status": {"const": "canonical-expanded-researched-successor"},
    "authority": {"type": "object", "additionalProperties": true},
    "predecessor": {"type": "object", "additionalProperties": true},
    "candidate_ledger": {"type": "object", "additionalProperties": true},
    "sources": {"type": "array", "minItems": 49, "items": {"type": "object", "required": ["source_id", "title", "url", "source_class", "authority", "scope", "version_or_revision", "retrieved_on", "normative"], "additionalProperties": false, "properties": {"source_id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string"}, "source_class": {"type": "string"}, "authority": {"type": "string"}, "scope": {"type": "string"}, "version_or_revision": {"type": "string"}, "retrieved_on": {"type": "string", "format": "date"}, "normative": {"type": "boolean"}}}},
    "semantic_facets": {"type": "array", "minItems": 15, "items": {"$ref": "#/$defs/facet"}},
    "operations": {"type": "array", "minItems": 33, "items": {"$ref": "#/$defs/operation"}},
    "modifiers": {"type": "array", "minItems": 32, "items": {"type": "object"}},
    "features": {"type": "array", "minItems": 268, "items": {"$ref": "#/$defs/feature"}},
    "manifestations": {"type": "array", "minItems": 324, "items": {"$ref": "#/$defs/manifestation"}},
    "carried_forward_by_reference": {"type": "object", "additionalProperties": true},
    "counts": {"type": "object", "additionalProperties": true},
    "snapshot_id": {"type": "string", "pattern": "^rcid:v1:ontology-snapshot:h:jcs-sha256-v1:"},
    "snapshot_digest_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assigned": {"type": "string", "pattern": "^rcid:v1:[a-z][a-z0-9-]*:u7:"},
    "facet": {"type": "object", "additionalProperties": false, "required": ["facet_id", "scientific_id", "title", "domain", "applicability", "canonical_authority", "obligation_derivation_use", "identity_basis", "derivation_id", "source_ids"], "properties": {"facet_id": {"type": "string", "pattern": "^facet\\."}, "scientific_id": {"$ref": "#/$defs/assigned"}, "title": {"type": "string"}, "domain": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "applicability": {"type": "string"}, "canonical_authority": {"type": "string"}, "obligation_derivation_use": {"type": "string"}, "identity_basis": {"type": "object"}, "derivation_id": {"$ref": "#/$defs/assigned"}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "operation": {"type": "object", "additionalProperties": true, "required": ["operation_id", "scientific_id", "semantic_contract", "identity_basis", "derivation_id", "source_ids"]},
    "assertion": {"type": "object", "additionalProperties": false, "required": ["field", "state", "scope", "statement", "source_ids", "derivation_id", "derivation_class", "rule_id"], "properties": {"field": {"type": "string"}, "state": {"enum": ["known", "no-feature-specific-implication", "not-applicable", "implementation-defined", "profile-dependent", "intentionally-under-specified", "unresolved"]}, "scope": {"type": "string"}, "statement": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "derivation_id": {"$ref": "#/$defs/assigned"}, "derivation_class": {"const": "research-derived"}, "rule_id": {"type": "string"}}},
    "feature": {"type": "object", "additionalProperties": true, "required": ["feature_id", "scientific_id", "canonical_name", "category", "feature_class", "semantic_revision", "semantic_assertions", "supported_operation_ids", "semantic_variants", "manifestation_ids", "identity_basis", "identity_disposition"], "properties": {"feature_id": {"type": "string", "pattern": "^feature\\."}, "scientific_id": {"$ref": "#/$defs/assigned"}, "canonical_name": {"type": "string"}, "category": {"type": "string"}, "feature_class": {"type": "string"}, "semantic_revision": {"const": 3}, "semantic_assertions": {"type": "object", "minProperties": 10, "additionalProperties": {"$ref": "#/$defs/assertion"}}, "supported_operation_ids": {"type": "array"}, "semantic_variants": {"type": "array"}, "manifestation_ids": {"type": "array"}, "identity_basis": {"type": "object"}, "identity_disposition": {"type": "object"}}},
    "manifestation": {"type": "object", "additionalProperties": true, "required": ["manifestation_id", "scientific_id", "source_id", "semantic_feature_id", "syntax_or_api_form", "kind", "derivation_id"]}
  }
}
