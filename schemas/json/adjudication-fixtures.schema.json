{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/adjudication-fixtures.schema.json",
  "title": "Synthetic adjudication fixtures",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "classification", "contract_ref", "evidence_records", "expected_outcomes", "applicability_results", "discrepancy_records", "discrepancy_history", "waiver_records", "quarantine_records", "execution_lineage_set", "valid_cases", "adversarial_cases", "fixture_set_id", "fixture_set_digest_sha256"],
  "properties": {
    "schema_version": {"const": "adjudication-fixtures.v1"},
    "classification": {"const": "synthetic-non-authoritative-no-production-credit"},
    "contract_ref": {"type": "object"},
    "evidence_records": {"type": "array", "minItems": 8, "items": {"type": "object"}},
    "expected_outcomes": {"type": "array", "minItems": 8, "items": {"type": "object"}},
    "applicability_results": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "discrepancy_records": {"type": "array", "minItems": 7, "items": {"type": "object"}},
    "discrepancy_history": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "waiver_records": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "quarantine_records": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "execution_lineage_set": {"type": "object"},
    "valid_cases": {"type": "array", "minItems": 15, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "request", "expected"], "properties": {"case_id": {"type": "string"}, "request": {"type": "object"}, "expected": {"type": "object"}}}},
    "adversarial_cases": {"type": "array", "minItems": 17, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "mode", "expected"], "properties": {"case_id": {"type": "string"}, "mode": {"type": "string"}, "expected": {"type": "string"}}}},
    "fixture_set_id": {"type": "string", "pattern": "^rcid:v1:artifact-set-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "fixture_set_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
