{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/downstream-lab-projection.schema.json",
  "title": "Coverage Shard Lab Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "coverage_shard_id", "profiles", "projection_digest_sha256", "projection_id", "schema_version", "semantic_snapshot_digest_sha256", "source_revision"],
  "properties": {
    "schema_version": {"const": "downstream-lab-projection.v1"},
    "projection_id": {"type": "string", "pattern": "^coverage-shard-[0-9]{4}\\.lab\\.v1$"},
    "coverage_shard_id": {"$ref": "#/$defs/shardId"},
    "semantic_snapshot_digest_sha256": {"$ref": "#/$defs/digest"},
    "source_revision": {"$ref": "#/$defs/gitSha"},
    "projection_digest_sha256": {"$ref": "#/$defs/digest"},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from_certified_evidence", "manually_authored_compatibility_truth", "primary_evidence", "website_authority"],
      "properties": {
        "derived_from_certified_evidence": {"const": true},
        "manually_authored_compatibility_truth": {"const": false},
        "primary_evidence": {"const": false},
        "website_authority": {"const": false}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rcid": {"type": "string", "pattern": "^rcid:v1:[a-z0-9]+(?:-[a-z0-9]+)*:(?:u7:[0-9a-f-]{36}|h:jcs-sha256-v1:[0-9a-f]{64})$"},
    "shardId": {"type": "string", "pattern": "^coverage-shard-[0-9]{4}$"},
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/rcid"},
        "relative_path": {"type": "string", "pattern": "^(?:adapters|environments)/[a-zA-Z0-9._/-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_refs", "display_name", "environment_recipe_refs", "lab_eligibility", "limitations", "operations", "options", "profile_id", "release_classification", "release_id", "system_id"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/rcid"},
        "release_id": {"$ref": "#/$defs/rcid"},
        "system_id": {"$ref": "#/$defs/rcid"},
        "display_name": {"type": "string", "minLength": 1},
        "release_classification": {"enum": ["current", "historical"]},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^operation\\.[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option_id", "values"],
            "properties": {
              "option_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
              "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["string", "number", "integer", "boolean"]}}
            }
          }
        },
        "environment_recipe_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sourceReference"}},
        "adapter_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sourceReference"}},
        "lab_eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible", "reason_code"],
          "properties": {
            "eligible": {"type": "boolean"},
            "reason_code": {"enum": ["eligible", "certified-unreproducible", "interactive-surface-unavailable", "policy-ineligible", "resource-ineligible"]},
            "explanation": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"eligible": {"const": true}}},
              "then": {"properties": {"reason_code": {"const": "eligible"}}, "not": {"required": ["explanation"]}},
              "else": {"required": ["explanation"], "properties": {"reason_code": {"not": {"const": "eligible"}}}}
            }
          ]
        },
        "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"lab_eligibility": {"properties": {"eligible": {"const": true}}}}},
          "then": {
            "properties": {
              "adapter_refs": {"minItems": 1},
              "environment_recipe_refs": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
