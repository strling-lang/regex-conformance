{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/lifecycle-event.schema.json",
  "title": "STRling Regex Conformance Lifecycle Event Protocol",
  "oneOf": [
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/cursor" },
    { "$ref": "#/$defs/batch" },
    { "$ref": "#/$defs/progress_projection" }
  ],
  "$defs": {
    "safe_integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positive_safe_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "token": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "opid": {
      "type": "string",
      "pattern": "^opid:v1:[a-z0-9]+(?:-[a-z0-9]+)*:u7:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^opid:v1:lifecycle-event:u7:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^opid:v1:event-journal:u7:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "progress_unit": { "enum": ["bytes", "environments", "executions", "items", "shards", "steps"] },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt", "attributes", "attributes_sha256", "canonical_authority", "causation_id",
        "correlation_id", "current", "event_digest", "event_id", "event_type", "message",
        "occurred_at", "operation_kind", "phase", "schema_version", "status", "stream_id",
        "stream_sequence", "terminal", "total", "unit"
      ],
      "properties": {
        "attempt": { "$ref": "#/$defs/positive_safe_integer" },
        "attributes": { "type": "object", "maxProperties": 128 },
        "attributes_sha256": { "$ref": "#/$defs/digest" },
        "canonical_authority": { "const": false },
        "causation_id": { "oneOf": [{ "$ref": "#/$defs/event_id" }, { "type": "null" }] },
        "correlation_id": { "oneOf": [{ "$ref": "#/$defs/opid" }, { "type": "null" }] },
        "current": { "oneOf": [{ "$ref": "#/$defs/safe_integer" }, { "type": "null" }] },
        "event_digest": { "$ref": "#/$defs/digest" },
        "event_id": { "$ref": "#/$defs/event_id" },
        "event_type": { "enum": ["checkpoint", "diagnostic", "lifecycle", "metric", "progress"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "operation_kind": { "$ref": "#/$defs/token" },
        "phase": { "$ref": "#/$defs/token" },
        "schema_version": { "const": "lifecycle-event.v1" },
        "status": { "$ref": "#/$defs/token" },
        "stream_id": { "$ref": "#/$defs/opid" },
        "stream_sequence": { "$ref": "#/$defs/positive_safe_integer" },
        "terminal": { "type": "boolean" },
        "total": { "oneOf": [{ "$ref": "#/$defs/safe_integer" }, { "type": "null" }] },
        "unit": { "oneOf": [{ "$ref": "#/$defs/progress_unit" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "current": { "type": "null" } }, "required": ["current"] },
          "then": { "properties": { "total": { "type": "null" }, "unit": { "type": "null" } } },
          "else": { "properties": { "unit": { "$ref": "#/$defs/progress_unit" } } }
        },
        {
          "if": { "properties": { "terminal": { "const": true } }, "required": ["terminal"] },
          "then": { "properties": { "status": { "enum": ["cancelled", "completed", "failed", "partial", "refused"] } } },
          "else": { "properties": { "status": { "not": { "enum": ["cancelled", "completed", "failed", "partial", "refused"] } } } }
        },
        {
          "if": { "properties": { "event_type": { "enum": ["checkpoint", "progress"] } }, "required": ["event_type"] },
          "then": { "properties": { "current": { "$ref": "#/$defs/safe_integer" } } }
        }
      ]
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal_id", "offset", "schema_version"],
      "properties": {
        "journal_id": { "$ref": "#/$defs/journal_id" },
        "offset": { "$ref": "#/$defs/safe_integer" },
        "schema_version": { "const": "event-cursor.v1" }
      }
    },
    "stored_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "offset"],
      "properties": {
        "event": { "$ref": "#/$defs/event" },
        "offset": { "$ref": "#/$defs/positive_safe_integer" }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "events", "has_more", "newest_retained_offset", "oldest_retained_offset", "schema_version"],
      "properties": {
        "cursor": { "$ref": "#/$defs/cursor" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/stored_event" } },
        "has_more": { "type": "boolean" },
        "newest_retained_offset": { "oneOf": [{ "$ref": "#/$defs/positive_safe_integer" }, { "type": "null" }] },
        "oldest_retained_offset": { "oneOf": [{ "$ref": "#/$defs/positive_safe_integer" }, { "type": "null" }] },
        "schema_version": { "const": "event-batch.v1" }
      }
    },
    "progress_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt", "current", "eta_seconds", "history_complete", "operation_kind", "percent_basis_points",
        "phase", "rate_milliunits_per_second", "sample_count", "schema_version", "status", "stream_id",
        "terminal", "total", "unit", "updated_at"
      ],
      "properties": {
        "attempt": { "$ref": "#/$defs/positive_safe_integer" },
        "current": { "oneOf": [{ "$ref": "#/$defs/safe_integer" }, { "type": "null" }] },
        "eta_seconds": { "oneOf": [{ "$ref": "#/$defs/safe_integer" }, { "type": "null" }] },
        "history_complete": { "type": "boolean" },
        "operation_kind": { "$ref": "#/$defs/token" },
        "percent_basis_points": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 10000 }, { "type": "null" }] },
        "phase": { "$ref": "#/$defs/token" },
        "rate_milliunits_per_second": { "oneOf": [{ "$ref": "#/$defs/safe_integer" }, { "type": "null" }] },
        "sample_count": { "$ref": "#/$defs/positive_safe_integer" },
        "schema_version": { "const": "progress-projection.v1" },
        "status": { "$ref": "#/$defs/token" },
        "stream_id": { "$ref": "#/$defs/opid" },
        "terminal": { "type": "boolean" },
        "total": { "oneOf": [{ "$ref": "#/$defs/safe_integer" }, { "type": "null" }] },
        "unit": { "oneOf": [{ "$ref": "#/$defs/progress_unit" }, { "type": "null" }] },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
