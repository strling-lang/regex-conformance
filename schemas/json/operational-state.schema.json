{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strling.dev/regex-conformance/schemas/operational-state.v1.schema.json",
  "title": "Local Operational State and Restart Reconciliation v1",
  "description": "Durable, recoverable, explicitly non-canonical Control Plane state and reconciliation records.",
  "oneOf": [
    { "$ref": "#/$defs/state_snapshot" },
    { "$ref": "#/$defs/reconciliation_observation" },
    { "$ref": "#/$defs/reconciliation_plan" },
    { "$ref": "#/$defs/reconciliation_report" }
  ],
  "$defs": {
    "safe_integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positive_safe_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "token": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "operational_id": {
      "type": "string",
      "pattern": "^opid:v1:[a-z][a-z0-9]*(?:-[a-z0-9]+)*:u7:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$"
    },
    "record_kind": {
      "enum": [
        "cache-inventory",
        "campaign-assignment",
        "environment-instance",
        "event-cursor",
        "lease",
        "machine-inventory",
        "resource-measurement",
        "shard-checkpoint",
        "spool-publication",
        "transfer",
        "worker-telemetry"
      ]
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "source_id", "source_kind", "verified"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\r\\n\\u0000]+$" },
        "source_kind": {
          "enum": ["immutable-evidence", "local-operation", "provider-reality", "repository-manifest"]
        },
        "verified": { "type": "boolean" }
      }
    },
    "operational_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_authority",
        "generation",
        "lifecycle_state",
        "payload",
        "payload_sha256",
        "record_id",
        "record_kind",
        "schema_version",
        "sources",
        "tombstoned",
        "updated_at",
        "verification_status"
      ],
      "properties": {
        "canonical_authority": { "const": false },
        "generation": { "$ref": "#/$defs/positive_safe_integer" },
        "lifecycle_state": { "$ref": "#/$defs/token" },
        "payload": { "type": "object" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "record_id": { "$ref": "#/$defs/record_id" },
        "record_kind": { "$ref": "#/$defs/record_kind" },
        "schema_version": { "const": "operational-state-record.v1" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_reference" }
        },
        "tombstoned": { "type": "boolean" },
        "updated_at": { "type": "string", "format": "date-time" },
        "verification_status": { "enum": ["provisional", "quarantined", "unverified", "verified"] }
      },
      "allOf": [
        {
          "if": { "properties": { "tombstoned": { "const": true } }, "required": ["tombstoned"] },
          "then": {
            "properties": {
              "lifecycle_state": { "const": "absent" },
              "payload": { "maxProperties": 0 },
              "verification_status": { "const": "verified" }
            }
          }
        },
        {
          "if": { "properties": { "lifecycle_state": { "const": "quarantined" } }, "required": ["lifecycle_state"] },
          "then": { "properties": { "verification_status": { "const": "quarantined" } } }
        },
        {
          "if": { "properties": { "verification_status": { "const": "quarantined" } }, "required": ["verification_status"] },
          "then": { "properties": { "lifecycle_state": { "const": "quarantined" } } }
        }
      ]
    },
    "state_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_state",
        "canonical_authority",
        "database_schema_version",
        "epoch",
        "observed_at",
        "prior_shutdown",
        "records",
        "schema_version",
        "snapshot_digest",
        "store_id"
      ],
      "properties": {
        "admission_state": { "enum": ["blocked", "ready", "reconciliation-required"] },
        "canonical_authority": { "const": false },
        "database_schema_version": { "$ref": "#/$defs/positive_safe_integer" },
        "epoch": { "$ref": "#/$defs/safe_integer" },
        "observed_at": { "type": "string", "format": "date-time" },
        "prior_shutdown": { "enum": ["clean", "new", "unclean"] },
        "records": { "type": "array", "items": { "$ref": "#/$defs/operational_record" } },
        "schema_version": { "const": "local-operational-state.v1" },
        "snapshot_digest": { "$ref": "#/$defs/sha256" },
        "store_id": { "$ref": "#/$defs/operational_id" }
      }
    },
    "reconciliation_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_authority",
        "exists",
        "lifecycle_state",
        "observed_at",
        "payload",
        "payload_sha256",
        "record_id",
        "record_kind",
        "source_id",
        "source_kind",
        "verified"
      ],
      "properties": {
        "canonical_authority": { "const": false },
        "exists": { "type": "boolean" },
        "lifecycle_state": { "oneOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "observed_at": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "record_id": { "$ref": "#/$defs/record_id" },
        "record_kind": { "$ref": "#/$defs/record_kind" },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\r\\n\\u0000]+$" },
        "source_kind": { "enum": ["immutable-evidence", "provider-reality", "repository-manifest"] },
        "verified": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "exists": { "const": false } }, "required": ["exists"] },
          "then": {
            "properties": {
              "lifecycle_state": { "type": "null" },
              "payload": { "maxProperties": 0 }
            }
          },
          "else": { "properties": { "lifecycle_state": { "$ref": "#/$defs/token" } } }
        }
      ]
    },
    "reconciliation_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking", "code", "detail", "record_id", "record_kind"],
      "properties": {
        "blocking": { "type": "boolean" },
        "code": { "$ref": "#/$defs/token" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$" },
        "record_id": { "$ref": "#/$defs/record_id" },
        "record_kind": { "$ref": "#/$defs/record_kind" }
      }
    },
    "reconciliation_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "expected_generation",
        "lifecycle_state",
        "payload",
        "payload_sha256",
        "reason_code",
        "record_id",
        "record_kind",
        "sources",
        "tombstoned",
        "verification_status"
      ],
      "properties": {
        "action": { "enum": ["create", "quarantine", "replace", "tombstone", "verify"] },
        "expected_generation": {
          "oneOf": [{ "$ref": "#/$defs/positive_safe_integer" }, { "type": "null" }]
        },
        "lifecycle_state": { "$ref": "#/$defs/token" },
        "payload": { "type": "object" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "reason_code": { "$ref": "#/$defs/token" },
        "record_id": { "$ref": "#/$defs/record_id" },
        "record_kind": { "$ref": "#/$defs/record_kind" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_reference" }
        },
        "tombstoned": { "type": "boolean" },
        "verification_status": { "enum": ["provisional", "quarantined", "unverified", "verified"] }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "create" } }, "required": ["action"] },
          "then": { "properties": { "expected_generation": { "type": "null" } } },
          "else": { "properties": { "expected_generation": { "$ref": "#/$defs/positive_safe_integer" } } }
        },
        {
          "if": { "properties": { "tombstoned": { "const": true } }, "required": ["tombstoned"] },
          "then": {
            "properties": {
              "action": { "const": "tombstone" },
              "lifecycle_state": { "const": "absent" },
              "payload": { "maxProperties": 0 },
              "verification_status": { "const": "verified" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "quarantine" } }, "required": ["action"] },
          "then": {
            "properties": {
              "lifecycle_state": { "const": "quarantined" },
              "verification_status": { "const": "quarantined" }
            }
          }
        }
      ]
    },
    "reconciliation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "canonical_authority",
        "issues",
        "maximum_observation_age_seconds",
        "observation_digest",
        "plan_digest",
        "plan_id",
        "planned_at",
        "ready_after_apply",
        "schema_version",
        "snapshot_digest"
      ],
      "properties": {
        "actions": { "type": "array", "items": { "$ref": "#/$defs/reconciliation_action" } },
        "canonical_authority": { "const": false },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/reconciliation_issue" } },
        "maximum_observation_age_seconds": { "$ref": "#/$defs/positive_safe_integer" },
        "observation_digest": { "$ref": "#/$defs/sha256" },
        "plan_digest": { "$ref": "#/$defs/sha256" },
        "plan_id": { "$ref": "#/$defs/operational_id" },
        "planned_at": { "type": "string", "format": "date-time" },
        "ready_after_apply": { "type": "boolean" },
        "schema_version": { "const": "state-reconciliation-plan.v1" },
        "snapshot_digest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "ready_after_apply": { "const": true } }, "required": ["ready_after_apply"] },
          "then": {
            "properties": {
              "issues": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/reconciliation_issue" },
                    { "properties": { "blocking": { "const": false } }, "required": ["blocking"] }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "reconciliation_action_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "code", "record_id", "record_kind", "resulting_generation"],
      "properties": {
        "action": { "enum": ["create", "quarantine", "replace", "tombstone", "verify"] },
        "code": { "$ref": "#/$defs/token" },
        "record_id": { "$ref": "#/$defs/record_id" },
        "record_kind": { "$ref": "#/$defs/record_kind" },
        "resulting_generation": { "$ref": "#/$defs/positive_safe_integer" }
      }
    },
    "reconciliation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_results",
        "after_snapshot_digest",
        "before_snapshot_digest",
        "canonical_authority",
        "completed_at",
        "issues",
        "plan_digest",
        "plan_id",
        "report_digest",
        "schema_version",
        "status"
      ],
      "properties": {
        "action_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/reconciliation_action_result" }
        },
        "after_snapshot_digest": { "$ref": "#/$defs/sha256" },
        "before_snapshot_digest": { "$ref": "#/$defs/sha256" },
        "canonical_authority": { "const": false },
        "completed_at": { "type": "string", "format": "date-time" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/reconciliation_issue" } },
        "plan_digest": { "$ref": "#/$defs/sha256" },
        "plan_id": { "$ref": "#/$defs/operational_id" },
        "report_digest": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": "state-reconciliation-report.v1" },
        "status": { "enum": ["blocked", "ready"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
          "then": {
            "properties": {
              "issues": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/reconciliation_issue" },
                    { "properties": { "blocking": { "const": false } }, "required": ["blocking"] }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
