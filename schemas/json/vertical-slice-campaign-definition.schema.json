{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/vertical-slice-campaign-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_definition_id", "campaign_id", "vector_source", "applicability_source",
    "classification", "operation", "shard_size", "limits", "requested_observations",
    "profile_inputs"
  ],
  "properties": {
    "schema_version": { "const": "vertical-slice-campaign-definition.v1" },
    "campaign_definition_id": { "$ref": "#/$defs/rcid" },
    "campaign_id": { "$ref": "#/$defs/rcid" },
    "vector_source": { "const": "vectors/definitions/first-positive-probes.v1.json" },
    "applicability_source": { "const": "applicability/policies/first-positive-probes.v1.json" },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["completion_denominator", "normative_authority", "probe_only", "semantic_authority"],
      "properties": {
        "completion_denominator": { "const": "development-only" },
        "normative_authority": { "const": false },
        "probe_only": { "const": true },
        "semantic_authority": { "const": false }
      }
    },
    "operation": { "const": "search" },
    "shard_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_diagnostic_bytes", "maximum_matches", "maximum_output_bytes", "wall_time_ms"],
      "properties": {
        "maximum_diagnostic_bytes": { "type": "integer", "minimum": 1 },
        "maximum_matches": { "type": "integer", "minimum": 1 },
        "maximum_output_bytes": { "type": "integer", "minimum": 1 },
        "wall_time_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "requested_observations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "profile_inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["selection_key", "dimensions", "options"],
        "properties": {
          "selection_key": { "$ref": "#/$defs/token" },
          "dimensions": { "$ref": "#/$defs/named_values" },
          "options": { "$ref": "#/$defs/named_values" }
        }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "rcid": { "type": "string", "pattern": "^rcid:v1:[a-z0-9]+(?:-[a-z0-9]+)*:(?:u7:[0-9a-f-]{36}|h:jcs-sha256-v1:[0-9a-f]{64})$" },
    "base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
    "datum": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["data", "domain", "encoding", "endianness", "unit_width_bits"],
          "properties": {
            "data": { "$ref": "#/$defs/base64url" },
            "domain": { "const": "octets" },
            "encoding": { "type": "null" },
            "endianness": { "type": "null" },
            "unit_width_bits": { "const": 8 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["domain", "encoding", "endianness", "text", "unit_width_bits"],
          "properties": {
            "domain": { "const": "unicode-scalars" },
            "encoding": { "const": "unicode-scalar-values" },
            "endianness": { "type": "null" },
            "text": { "type": "string", "maxLength": 4194304 },
            "unit_width_bits": { "type": "null" }
          }
        }
      ]
    },
    "named_values": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "value"],
        "properties": { "name": { "$ref": "#/$defs/token" }, "value": {} }
      }
    }
  }
}
