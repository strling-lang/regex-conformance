{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/oracle-record.schema.json",
  "title": "Versioned oracle record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oracle_record_version", "contract_ref", "requirement_scientific_id", "oracle_class", "resolution_state", "scope", "applicability_conditions", "provenance", "dependency_graph", "independence", "permitted_judgments", "expected_result", "promotion_event", "derivation", "oracle_id", "oracle_digest_sha256"],
  "properties": {
    "schema_version": {"const": "oracle-record.v1"},
    "oracle_record_version": {"const": "1.0.0"},
    "contract_ref": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_digest_sha256"], "properties": {"contract_id": {"$ref": "#/$defs/rcid"}, "contract_digest_sha256": {"$ref": "#/$defs/sha256"}}},
    "requirement_scientific_id": {"type": "string", "pattern": "^rcid:v1:semantic-requirement:u7:"},
    "oracle_class": {"enum": ["O1", "O2", "O3", "O4", "O5", "O6", "O7", "O8"]},
    "resolution_state": {"enum": ["oracle-established", "oracle-inapplicable", "expectation-ambiguous", "expectation-under-specified", "conflicting-authoritative-expectations", "oracle-inputs-unavailable", "characterization-only"]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["kind", "operation_scientific_ids", "profile_ids", "profile_family_id", "semantic_assertion_revision_ids"], "properties": {"kind": {"enum": ["external-normative", "formal-model", "data-version-scoped", "same-profile-relation", "family-relative", "implementation-self-documentation", "historical-characterization", "characterization"]}, "operation_scientific_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/rcid"}}, "profile_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^rcid:v1:profile:u7:"}}, "profile_family_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^rcid:v1:profile-family:u7:"}]}, "semantic_assertion_revision_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rcid"}}}},
    "applicability_conditions": {"type": "object", "additionalProperties": false, "required": ["operator", "clauses"], "properties": {"operator": {"const": "all"}, "clauses": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["field", "operator", "value"], "properties": {"field": {"type": "string"}, "operator": {"enum": ["equals", "contains", "intersects"]}, "value": {}}}}}},
    "provenance": {"type": "object", "minProperties": 4},
    "dependency_graph": {"type": "object", "additionalProperties": false, "required": ["nodes", "root_dependency_ids"], "properties": {"nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependency"}}, "root_dependency_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "independence": {"type": "object", "additionalProperties": false, "required": ["evaluated_profile_ids", "stimulus_generator_authority_domain_ids", "requires_independent_basis"], "properties": {"evaluated_profile_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^rcid:v1:profile:u7:"}}, "stimulus_generator_authority_domain_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "requires_independent_basis": {"type": "boolean"}}},
    "permitted_judgments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "expected_result": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["result_type", "value", "scope_statement"], "properties": {"result_type": {"enum": ["conventional", "relation"]}, "value": {}, "scope_statement": {"type": "string", "minLength": 1}}}]},
    "promotion_event": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["derivation_id", "derivation_revision_id", "derivation_class"], "properties": {"derivation_id": {"$ref": "#/$defs/rcid"}, "derivation_revision_id": {"$ref": "#/$defs/rcid"}, "derivation_class": {"const": "manual-decision"}}},
    "oracle_id": {"type": "string", "pattern": "^rcid:v1:expectation-projection:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "oracle_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rcid": {"type": "string", "pattern": "^rcid:v1:"},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["dependency_id", "kind", "semantic_role", "authority_domain_id", "version", "content_digest_sha256", "upstream_dependency_ids", "subject_profile_ids", "semantic_evaluator"], "properties": {"dependency_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["absence-of-authority", "authoritative-dataset", "designated-reference-profile", "empirical-consensus", "empirical-observation", "expectation-projection", "formal-construction", "generator", "historical-observation", "implementation-documentation", "normative-source-proposition", "relation-definition", "research-claim", "target-implementation-output"]}, "semantic_role": {"enum": ["comparison-input", "context-only", "descriptive-statistic", "expected-basis", "historical-subject", "promotion-source", "stimulus-only"]}, "authority_domain_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "content_digest_sha256": {"$ref": "#/$defs/sha256"}, "upstream_dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "subject_profile_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^rcid:v1:profile:u7:"}}, "semantic_evaluator": {"type": "boolean"}}}
  }
}
