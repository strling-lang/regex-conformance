{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/oracle-authority-index.schema.json",
  "title": "Oracle current-authority index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "current_contract", "validation_fixture", "foundation_report", "semantic_requirement_authority", "historical_compatibility", "next_interfaces", "governance", "derivation", "index_id", "index_digest_sha256"],
  "properties": {
    "schema_version": {"const": "oracle-authority-index.v1"},
    "current_contract": {"$ref": "#/$defs/artifact"},
    "validation_fixture": {"$ref": "#/$defs/artifact"},
    "foundation_report": {"$ref": "#/$defs/artifact"},
    "semantic_requirement_authority": {"$ref": "#/$defs/artifact"},
    "historical_compatibility": {"type": "object", "additionalProperties": false, "required": ["existing_observations_rewritten", "existing_campaigns_reinterpreted", "mutable_latest_alias_is_certified_input", "migration_rule"], "properties": {"existing_observations_rewritten": {"const": false}, "existing_campaigns_reinterpreted": {"const": false}, "mutable_latest_alias_is_certified_input": {"const": false}, "migration_rule": {"const": "prospective-versioned-no-rewrite"}}},
    "next_interfaces": {"type": "object", "additionalProperties": false, "required": ["applicability", "claims_and_adjudication", "waivers", "production_vectors"], "properties": {"applicability": {"const": "deferred"}, "claims_and_adjudication": {"const": "deferred"}, "waivers": {"const": "deferred"}, "production_vectors": {"const": "deferred"}}},
    "governance": {"type": "string", "minLength": 1},
    "derivation": {"type": "object"},
    "index_id": {"type": "string", "pattern": "^rcid:v1:artifact-set-manifest:h:"},
    "index_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "artifact_id", "digest_sha256", "file_sha256"], "properties": {"path": {"type": "string"}, "artifact_id": {"type": "string"}, "digest_sha256": {"$ref": "#/$defs/sha256"}, "file_sha256": {"$ref": "#/$defs/sha256"}}}}
}
