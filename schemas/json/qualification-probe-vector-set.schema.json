{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/qualification-probe-vector-set.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "vector_family_id", "classification", "coverage_authority", "vectors"],
  "properties": {
    "schema_version": {"const": "qualification-probe-vector-set.v1"},
    "vector_family_id": {"type": "string", "pattern": "^rcid:v1:vector-family:u7:"},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["normative_authority", "probe_only", "semantic_authority"],
      "properties": {"normative_authority": {"const": false}, "probe_only": {"const": true}, "semantic_authority": {"const": false}}
    },
    "coverage_authority": {"const": "operational-qualification-only-no-knowledge-feature-credit"},
    "vectors": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/vector"}}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]*$"},
    "namedValue": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "value": {"oneOf": [{"type": "boolean"}, {"type": "integer"}, {"type": "string", "maxLength": 4096}, {"type": "null"}]}
      }
    },
    "datum": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["data", "domain", "encoding", "endianness", "unit_width_bits"],
          "properties": {"data": {"$ref": "#/$defs/base64url"}, "domain": {"const": "octets"}, "encoding": {"type": "null"}, "endianness": {"type": "null"}, "unit_width_bits": {"const": 8}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["domain", "encoding", "endianness", "text", "unit_width_bits"],
          "properties": {"domain": {"const": "unicode-scalars"}, "encoding": {"const": "unicode-scalar-values"}, "endianness": {"type": "null"}, "text": {"type": "string", "maxLength": 4194304}, "unit_width_bits": {"type": "null"}}
        }
      ]
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_diagnostic_bytes", "maximum_matches", "maximum_output_bytes", "wall_time_ms"],
      "properties": {
        "maximum_diagnostic_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximum_matches": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maximum_output_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
      }
    },
    "vector": {
      "type": "object", "additionalProperties": false,
      "required": ["vector_id", "key", "domain", "qualification_categories", "operation", "pattern", "subjects", "replacement", "callback_fixture", "options", "initial_state", "requested_observations", "limits"],
      "properties": {
        "vector_id": {"type": "string", "pattern": "^rcid:v1:vector:u7:"},
        "key": {"$ref": "#/$defs/token"},
        "domain": {"enum": ["octets", "unicode-scalars"]},
        "qualification_categories": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["capture", "error", "iteration", "profile-differential", "rejection", "replacement", "success", "timeout", "unicode"]}
        },
        "operation": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"enum": ["capture-extraction", "compile", "find-all", "full-match", "replace-all", "replace-once", "search", "split", "test"]},
            "version": {"const": "1.0.0"}
          }
        },
        "pattern": {"$ref": "#/$defs/datum"},
        "subjects": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/datum"}},
        "replacement": {"oneOf": [{"$ref": "#/$defs/datum"}, {"type": "null"}]},
        "callback_fixture": {"type": "null"},
        "options": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/namedValue"}},
        "initial_state": {
          "type": "object", "additionalProperties": false,
          "required": ["occurrence", "start_offset"],
          "properties": {"occurrence": {"type": "integer", "minimum": 1}, "start_offset": {"type": "integer", "minimum": 0}}
        },
        "requested_observations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["capture-history", "captures", "compile-diagnostics", "cursor", "match-state", "native-errors", "replacement-output", "runtime-identity", "spans", "split-output"]}
        },
        "limits": {"$ref": "#/$defs/limits"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"properties": {"name": {"enum": ["replace-all", "replace-once"]}}}}},
          "then": {"properties": {"replacement": {"$ref": "#/$defs/datum"}}},
          "else": {"properties": {"replacement": {"type": "null"}}}
        }
      ]
    }
  }
}
