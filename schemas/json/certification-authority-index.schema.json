{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/certification-authority-index.schema.json",
  "title": "Regex Conformance Certification Authority Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions", "authority_index_sha256", "certifications", "current_certification_id", "current_contract", "current_evaluation", "schema_version"],
  "properties": {
    "schema_version": {"const": "certification-authority-index.v1"},
    "authority_index_sha256": {"$ref": "#/$defs/digest"},
    "current_contract": {"$ref": "#/$defs/contractRef"},
    "current_evaluation": {"$ref": "#/$defs/reportRef"},
    "current_certification_id": {"anyOf": [{"$ref": "#/$defs/certificationId"}, {"type": "null"}]},
    "certifications": {"type": "array", "items": {"$ref": "#/$defs/certification"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "certificationId": {"type": "string", "pattern": "^rcid:v1:certification:u7:[0-9a-f-]{36}$"},
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_digest_sha256", "contract_id", "contract_version"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^rcid:v1:certification-definition:h:jcs-sha256-v1:[0-9a-f]{64}$"},
        "contract_digest_sha256": {"$ref": "#/$defs/digest"},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "reportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_state", "report_digest_sha256", "report_id"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^rcid:v1:certification-report:h:jcs-sha256-v1:[0-9a-f]{64}$"},
        "report_digest_sha256": {"$ref": "#/$defs/digest"},
        "final_state": {"enum": ["BLOCKED", "FAIL", "PASS"]}
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certification_id", "issued_at", "report_digest_sha256", "report_id", "scope_id", "status"],
      "properties": {
        "certification_id": {"$ref": "#/$defs/certificationId"},
        "report_id": {"type": "string", "pattern": "^rcid:v1:certification-report:h:jcs-sha256-v1:[0-9a-f]{64}$"},
        "report_digest_sha256": {"$ref": "#/$defs/digest"},
        "scope_id": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["current", "revoked", "superseded"]}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "effective_at", "evidence_references", "kind", "reason", "subject_certification_id", "successor_certification_id"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^rcid:v1:certification-action:u7:[0-9a-f-]{36}$"},
        "kind": {"enum": ["revoke", "supersede"]},
        "subject_certification_id": {"$ref": "#/$defs/certificationId"},
        "successor_certification_id": {"anyOf": [{"$ref": "#/$defs/certificationId"}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effective_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
