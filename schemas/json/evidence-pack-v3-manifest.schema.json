{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/evidence-pack-v3-manifest.schema.json",
  "title": "Compact Evidence Pack Immutable Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority", "blocks", "counts", "derivations", "format", "omitted_information", "pack_digest_sha256", "schema_version", "source_binding"],
  "properties": {
    "schema_version": {"const": "evidence-pack-manifest.v3"},
    "pack_digest_sha256": {"$ref": "#/$defs/digest"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analytics_authoritative", "independent_observations_preserved", "independent_physical_attempts_preserved", "raw_empirical_evidence", "retained_fact_contract"],
      "properties": {
        "analytics_authoritative": {"const": false},
        "independent_observations_preserved": {"const": true},
        "independent_physical_attempts_preserved": {"const": true},
        "raw_empirical_evidence": {"const": true},
        "retained_fact_contract": {"const": "semantic-diagnostic-performance-provenance-complete.v1"}
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_class", "key", "lookup_group", "ordinal", "raw_sha256", "raw_size_bytes", "role", "stored_sha256", "stored_size_bytes"],
        "properties": {
          "evidence_class": {"enum": ["canonical_inputs", "diagnostics", "manifests_integrity", "performance_resource_samples", "physical_attempt_facts", "profile_environment_release_provenance", "semantic_results", "shared_dictionary_cas"]},
          "key": {"type": "string", "pattern": "^regex-conformance/evidence-pack-v3/objects/sha256/[0-9a-f]{64}\\.xz$"},
          "lookup_group": {"type": "integer", "minimum": 0},
          "ordinal": {"type": "integer", "minimum": 0},
          "raw_sha256": {"$ref": "#/$defs/digest"},
          "raw_size_bytes": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "stored_sha256": {"$ref": "#/$defs/digest"},
          "stored_size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_executions", "observations", "physical_attempts"],
      "properties": {
        "logical_executions": {"type": "integer", "minimum": 1},
        "observations": {"type": "integer", "minimum": 1},
        "physical_attempts": {"type": "integer", "minimum": 1}
      }
    },
    "derivations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_logical_inputs", "observation_identity", "physical_attempt_identity"],
      "properties": {
        "canonical_logical_inputs": {"type": "string", "minLength": 1},
        "observation_identity": {"const": "sha256(campaign-manifest,partition,shard,logical-index)"},
        "physical_attempt_identity": {"const": "sha256(campaign-manifest,partition,shard,logical-index,attempt-number)"}
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compression", "content_addressed_objects", "deterministic", "maximum_object_reads_per_lookup", "normal_list_requests", "token_tables", "version"],
      "properties": {
        "compression": {"const": "xz-sha256-preset9"},
        "content_addressed_objects": {"const": true},
        "deterministic": {"const": true},
        "maximum_object_reads_per_lookup": {"type": "integer", "minimum": 1, "maximum": 3},
        "normal_list_requests": {"const": 0},
        "token_tables": {"const": "typed-token-table-v3"},
        "version": {"const": 3}
      }
    },
    "omitted_information": {
      "type": "array",
      "prefixItems": [
        {"const": "legacy-random-observation-uuidv7-labels"},
        {"const": "legacy-random-physical-attempt-uuidv7-labels"},
        {"const": "legacy-v2-container-path-and-object-identities"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_manifest_sha256"],
      "properties": {"campaign_manifest_sha256": {"$ref": "#/$defs/digest"}}
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
