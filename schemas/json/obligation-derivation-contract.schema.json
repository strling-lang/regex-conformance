{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/obligation-derivation-contract.schema.json",
  "title": "Explainable semantic obligation derivation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "published_on", "classification", "semantic_authority", "semantic_foundation", "denominator_boundary", "decision_vocabulary", "semantic_state_policy", "question_types", "concept_boundaries", "obligation_identity_contract", "obligation_archetypes", "modifier_identities", "operation_families", "operation_rules", "facet_rules", "interaction_policy", "operation_condition_contract", "explainability_contract", "derivation_id", "derivation_revision_id", "contract_id", "contract_digest_sha256"],
  "properties": {
    "schema_version": {"const": "obligation-derivation-contract.v1"},
    "contract_version": {"const": "1.0.0"},
    "published_on": {"type": "string", "format": "date"},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["design_only", "authoritative_denominator", "production_vectors_generated", "profile_applicability_evaluated", "template_fallback_permitted"],
      "properties": {"design_only": {"const": true}, "authoritative_denominator": {"const": false}, "production_vectors_generated": {"const": false}, "profile_applicability_evaluated": {"const": false}, "template_fallback_permitted": {"const": false}}
    },
    "semantic_authority": {"$ref": "#/$defs/semanticAuthority"},
    "semantic_foundation": {"$ref": "#/$defs/fileRef"},
    "denominator_boundary": {"$ref": "#/$defs/denominatorBoundary"},
    "decision_vocabulary": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["required", "conditionally-required", "not-applicable", "not-required-by-feature-semantics", "blocked-by-unresolved-semantics"]}},
    "semantic_state_policy": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["state", "effect"], "properties": {"state": {"enum": ["known", "no-feature-specific-implication", "not-applicable", "implementation-defined", "profile-dependent", "intentionally-under-specified", "unresolved"]}, "effect": {"type": "string", "minLength": 1}}}},
    "question_types": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["question_type", "meaning"], "properties": {"question_type": {"type": "string", "minLength": 1}, "meaning": {"type": "string", "minLength": 1}}}},
    "concept_boundaries": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "minLength": 1}},
    "obligation_identity_contract": {"type": "object", "required": ["materialization_deferred", "analysis_keys_are_not_scientific_ids", "canonical_identity_inputs", "excluded_presentation_inputs"], "properties": {"materialization_deferred": {"const": true}, "analysis_keys_are_not_scientific_ids": {"const": true}, "canonical_identity_inputs": {"$ref": "#/$defs/nonEmptyStrings"}, "excluded_presentation_inputs": {"$ref": "#/$defs/nonEmptyStrings"}}, "additionalProperties": false},
    "obligation_archetypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/archetype"}},
    "modifier_identities": {"type": "array", "minItems": 33, "maxItems": 33, "items": {"type": "object", "additionalProperties": false, "required": ["modifier_id", "modifier_scientific_id"], "properties": {"modifier_id": {"type": "string", "pattern": "^modifier\\."}, "modifier_scientific_id": {"type": "string", "pattern": "^rcid:v1:modifier:u7:"}}}},
    "operation_families": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["operation_family_id", "operation_ids"], "properties": {"operation_family_id": {"type": "string", "pattern": "^operation-family\\."}, "operation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^operation\\."}}}}},
    "operation_rules": {"type": "array", "minItems": 33, "maxItems": 33, "items": {"$ref": "#/$defs/operationRule"}},
    "facet_rules": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/facetRule"}},
    "interaction_policy": {"type": "object", "required": ["allowed_triggers", "forbidden_trigger", "independent_obligation_rule", "constituent_coverage_rule"], "properties": {"allowed_triggers": {"$ref": "#/$defs/nonEmptyStrings"}, "forbidden_trigger": {"type": "string"}, "independent_obligation_rule": {"type": "string"}, "constituent_coverage_rule": {"type": "string"}}, "additionalProperties": false},
    "operation_condition_contract": {"type": "object", "required": ["missing_profile_capability_state", "not_applicable_requires_evidence", "final_applicability_evaluator_deferred", "allowed_profile_fields", "allowed_operators", "identity_reference_requirement"], "properties": {"missing_profile_capability_state": {"const": "conditionally-required"}, "not_applicable_requires_evidence": {"const": true}, "final_applicability_evaluator_deferred": {"const": true}, "allowed_profile_fields": {"$ref": "#/$defs/nonEmptyStrings"}, "allowed_operators": {"$ref": "#/$defs/nonEmptyStrings"}, "identity_reference_requirement": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "explainability_contract": {"type": "object", "required": ["chain", "every_feature_facet_has_one_decision", "suppression_is_explained", "generic_fallback_rule"], "properties": {"chain": {"$ref": "#/$defs/nonEmptyStrings"}, "every_feature_facet_has_one_decision": {"const": true}, "suppression_is_explained": {"const": true}, "generic_fallback_rule": {"type": "null"}}, "additionalProperties": false},
    "derivation_id": {"$ref": "#/$defs/derivationId"},
    "derivation_revision_id": {"$ref": "#/$defs/derivationRevisionId"},
    "contract_id": {"type": "string", "pattern": "^rcid:v1:artifact-set-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "contract_digest_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derivationId": {"type": "string", "pattern": "^rcid:v1:assertion-derivation:u7:"},
    "derivationRevisionId": {"type": "string", "pattern": "^rcid:v1:assertion-derivation-revision:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "ruleRevisionId": {"type": "string", "pattern": "^rcid:v1:applicability-rule-set:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "predicate": {"type": "object", "minProperties": 2},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["path", "file_sha256"], "properties": {"path": {"type": "string"}, "file_sha256": {"$ref": "#/$defs/digest"}}},
    "semanticAuthority": {"type": "object", "additionalProperties": false, "required": ["path", "snapshot_id", "snapshot_digest_sha256", "feature_count", "facet_count", "operation_count"], "properties": {"path": {"type": "string"}, "snapshot_id": {"type": "string"}, "snapshot_digest_sha256": {"$ref": "#/$defs/digest"}, "feature_count": {"const": 269}, "facet_count": {"const": 15}, "operation_count": {"const": 33}}},
    "denominatorBoundary": {"type": "object", "additionalProperties": false, "required": ["state", "obligation_templates", "vector_requirements", "artifact_sha256", "artifacts_unchanged"], "properties": {"state": {"const": "pre-rederivation-predecessor-bound"}, "obligation_templates": {"const": 12048}, "vector_requirements": {"const": 9506}, "artifact_sha256": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/digest"}}, "artifacts_unchanged": {"const": true}}},
    "archetype": {"type": "object", "additionalProperties": false, "required": ["archetype_id", "scientific_question", "subject_polarities", "parameterizable", "contributes_to_c4"], "properties": {"archetype_id": {"type": "string", "pattern": "^archetype\\."}, "scientific_question": {"type": "string", "minLength": 1}, "subject_polarities": {"$ref": "#/$defs/nonEmptyStrings"}, "parameterizable": {"type": "boolean"}, "contributes_to_c4": {"type": "boolean"}}},
    "commonRule": {"type": "object", "required": ["rule_key", "rule_revision_id", "rationale", "depends_on_rule_ids", "derivation_id", "derivation_revision_id"]},
    "facetRule": {"allOf": [{"$ref": "#/$defs/commonRule"}, {"type": "object", "additionalProperties": false, "required": ["rule_key", "rule_revision_id", "facet_id", "facet_scientific_id", "semantic_input_selectors", "operation_family_ids", "archetype_ids", "policy", "rationale", "required_semantic_states", "excluded_semantic_states", "blocked_semantic_states", "profile_capability_predicate", "reason_template", "depends_on_rule_ids", "derivation_id", "derivation_revision_id"], "properties": {"rule_key": {"type": "string"}, "rule_revision_id": {"$ref": "#/$defs/ruleRevisionId"}, "facet_id": {"type": "string", "pattern": "^facet\\."}, "facet_scientific_id": {"type": "string", "pattern": "^rcid:v1:semantic-facet:u7:"}, "semantic_input_selectors": {"$ref": "#/$defs/nonEmptyStrings"}, "operation_family_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^operation-family\\."}}, "archetype_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^archetype\\."}}, "policy": {"enum": ["semantic-state", "core-definition", "typed-interaction", "analysis-only", "phase-sensitive", "documented-complexity", "documented-security"]}, "rationale": {"type": "string", "minLength": 1}, "required_semantic_states": {"$ref": "#/$defs/nonEmptyStrings"}, "excluded_semantic_states": {"$ref": "#/$defs/nonEmptyStrings"}, "blocked_semantic_states": {"$ref": "#/$defs/nonEmptyStrings"}, "profile_capability_predicate": {"$ref": "#/$defs/predicate"}, "reason_template": {"type": "string", "minLength": 1}, "depends_on_rule_ids": {"type": "array", "maxItems": 0}, "derivation_id": {"$ref": "#/$defs/derivationId"}, "derivation_revision_id": {"$ref": "#/$defs/derivationRevisionId"}}}]},
    "operationRule": {"allOf": [{"$ref": "#/$defs/commonRule"}, {"type": "object", "additionalProperties": false, "required": ["rule_key", "rule_revision_id", "operation_id", "operation_scientific_id", "operation_family_id", "phase", "feature_selector", "applicability", "profile_capability_predicate", "covered_by_operation_id", "rationale", "depends_on_rule_ids", "derivation_id", "derivation_revision_id"], "properties": {"rule_key": {"type": "string"}, "rule_revision_id": {"$ref": "#/$defs/ruleRevisionId"}, "operation_id": {"type": "string", "pattern": "^operation\\."}, "operation_scientific_id": {"type": "string", "pattern": "^rcid:v1:operation:u7:"}, "operation_family_id": {"type": "string", "pattern": "^operation-family\\."}, "phase": {"enum": ["build-source-generation", "compile", "match-search", "replacement-substitution", "stream-session", "serialization-deserialization"]}, "feature_selector": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["declared-support", "all-compilable", "stream-capable", "feature-id-set", "feature-class-set"]}, "feature_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^feature\\."}}, "feature_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false}, "applicability": {"enum": ["intrinsically-required-when-feature-declares-operation", "conditionally-applicable-when-profile-exposes-operation"]}, "profile_capability_predicate": {"$ref": "#/$defs/predicate"}, "covered_by_operation_id": {"type": ["string", "null"]}, "rationale": {"type": "string", "minLength": 1}, "depends_on_rule_ids": {"type": "array", "maxItems": 0}, "derivation_id": {"$ref": "#/$defs/derivationId"}, "derivation_revision_id": {"$ref": "#/$defs/derivationRevisionId"}}}]}
  }
}
