{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/coverage-shard-checkpoint.schema.json",
  "title": "Certified Coverage Shard Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["certification", "checkpoint_digest_sha256", "checkpoint_id", "compatibility_projection", "coverage", "evidence_manifest", "lab_projection", "previous_checkpoint", "profile_snapshot", "schema_version", "semantic_snapshot", "sequence", "source_revision"],
  "properties": {
    "schema_version": {"const": "coverage-shard-checkpoint.v1"},
    "checkpoint_id": {"$ref": "#/$defs/shardId"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9999},
    "previous_checkpoint": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint_digest_sha256", "checkpoint_id", "relative_path"],
          "properties": {
            "checkpoint_id": {"$ref": "#/$defs/shardId"},
            "checkpoint_digest_sha256": {"$ref": "#/$defs/digest"},
            "relative_path": {"type": "string", "pattern": "^downstream/checkpoints/coverage-shard-[0-9]{4}\\.v1\\.json$"}
          }
        }
      ]
    },
    "semantic_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "semantic_digest_sha256"],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^semantic-corpus/snapshots/[a-zA-Z0-9._-]+\\.json$"},
        "semantic_digest_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "profile_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^registries/profiles/[a-zA-Z0-9._-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "profiles"],
      "properties": {
        "counts": {"$ref": "#/$defs/counts"},
        "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profileCoverage"}}
      }
    },
    "evidence_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_object_key", "manifest_sha256", "pack_digest_sha256", "readback_verified", "schema_version", "size_bytes"],
      "properties": {
        "schema_version": {"const": "evidence-pack-manifest.v3"},
        "manifest_object_key": {"type": "string", "pattern": "^regex-conformance/evidence-pack-v3/[a-z0-9/_-]+/[0-9a-f]{64}\\.json$"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "pack_digest_sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "readback_verified": {"const": true}
      }
    },
    "lab_projection": {"$ref": "#/$defs/projectionReference"},
    "compatibility_projection": {"$ref": "#/$defs/projectionReference"},
    "source_revision": {"$ref": "#/$defs/gitSha"},
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity_admission_pass", "certification_digest_sha256", "completeness_conjunction_pass", "downstream_publication_gate_pass", "evidence_reconciliation_pass"],
      "properties": {
        "certification_digest_sha256": {"$ref": "#/$defs/digest"},
        "completeness_conjunction_pass": {"const": true},
        "evidence_reconciliation_pass": {"const": true},
        "downstream_publication_gate_pass": {"const": true},
        "capacity_admission_pass": {"const": true}
      }
    },
    "checkpoint_digest_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rcid": {"type": "string", "pattern": "^rcid:v1:[a-z0-9]+(?:-[a-z0-9]+)*:(?:u7:[0-9a-f-]{36}|h:jcs-sha256-v1:[0-9a-f]{64})$"},
    "shardId": {"type": "string", "pattern": "^coverage-shard-[0-9]{4}$"},
    "nullableDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "projectionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_id", "relative_path", "sha256"],
      "properties": {
        "projection_id": {"type": "string", "pattern": "^coverage-shard-[0-9]{4}\\.(?:lab|compatibility)\\.v1$"},
        "relative_path": {"type": "string", "pattern": "^downstream/(?:lab|compatibility)/coverage-shard-[0-9]{4}\\.v1\\.json$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility_published_profile_count", "credited_coordinate_count", "governed_non_executable_coordinate_count", "governed_not_applicable_coordinate_count", "lab_eligible_profile_count", "planned_applicable_coordinate_count", "profile_count", "unexpected_skip_count"],
      "properties": {
        "profile_count": {"type": "integer", "minimum": 1},
        "planned_applicable_coordinate_count": {"type": "integer", "minimum": 0},
        "credited_coordinate_count": {"type": "integer", "minimum": 0},
        "governed_non_executable_coordinate_count": {"type": "integer", "minimum": 0},
        "governed_not_applicable_coordinate_count": {"type": "integer", "minimum": 0},
        "unexpected_skip_count": {"const": 0},
        "lab_eligible_profile_count": {"type": "integer", "minimum": 0},
        "compatibility_published_profile_count": {"type": "integer", "minimum": 0}
      }
    },
    "profileCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility_published", "credited_coordinate_count", "governed_non_executable_coordinate_count", "governed_not_applicable_coordinate_count", "lab_eligible", "limitation_digest_sha256", "planned_applicable_coordinate_count", "profile_id", "release_classification", "release_id", "reproducibility_disposition", "unexpected_skip_count"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/rcid"},
        "release_id": {"$ref": "#/$defs/rcid"},
        "release_classification": {"enum": ["current", "historical"]},
        "reproducibility_disposition": {"enum": ["reproducibly-executable", "explicitly-unreproducible"]},
        "planned_applicable_coordinate_count": {"type": "integer", "minimum": 0},
        "credited_coordinate_count": {"type": "integer", "minimum": 0},
        "governed_non_executable_coordinate_count": {"type": "integer", "minimum": 0},
        "governed_not_applicable_coordinate_count": {"type": "integer", "minimum": 0},
        "unexpected_skip_count": {"const": 0},
        "lab_eligible": {"type": "boolean"},
        "compatibility_published": {"type": "boolean"},
        "limitation_digest_sha256": {"$ref": "#/$defs/nullableDigest"}
      }
    }
  }
}
