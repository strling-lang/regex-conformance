{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/evidence-admissibility-contract.schema.json",
  "title": "Normative and characterization evidence admissibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "effective_on", "authority_scope", "oracle_foundation", "knowledge_authority", "semantic_requirement_authority", "evidence_roles", "epistemic_uses", "normative_strengths", "quality_axes", "admissibility_decision_contract", "immutable_provenance_contract", "authority_domain_contract", "prohibitions", "derivation", "contract_id", "contract_digest_sha256"],
  "properties": {
    "schema_version": {"const": "evidence-admissibility-contract.v1"},
    "contract_version": {"const": "1.0.0"},
    "effective_on": {"type": "string", "format": "date"},
    "authority_scope": {"type": "string", "minLength": 1},
    "oracle_foundation": {"$ref": "#/$defs/artifactRef"},
    "knowledge_authority": {"$ref": "#/$defs/artifactRef"},
    "semantic_requirement_authority": {
      "allOf": [{"$ref": "#/$defs/artifactRef"}],
      "properties": {"requirement_count": {"const": 3378}}
    },
    "evidence_roles": {
      "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_role", "oracle_class", "epistemic_function", "required_provenance_fields", "potentially_admitted_uses", "permitted_conclusions", "expectation_bearing", "conclusion_boundary"],
        "properties": {
          "evidence_role": {"$ref": "#/$defs/evidenceRole"},
          "oracle_class": {"pattern": "^O[1-8]$", "type": "string"},
          "epistemic_function": {"type": "string", "minLength": 1},
          "required_provenance_fields": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "potentially_admitted_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/epistemicUse"}},
          "permitted_conclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "expectation_bearing": {"type": "boolean"},
          "conclusion_boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "epistemic_uses": {
      "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["epistemic_use", "meaning", "admissible_evidence_roles", "permitted_conclusions", "correctness_establishing", "independence_required"],
        "properties": {
          "epistemic_use": {"$ref": "#/$defs/epistemicUse"},
          "meaning": {"type": "string", "minLength": 1},
          "admissible_evidence_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRole"}},
          "permitted_conclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "correctness_establishing": {"type": "boolean"},
          "independence_required": {"type": "boolean"}
        }
      }
    },
    "normative_strengths": {
      "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["strength", "meaning", "may_establish_concrete_expectation", "permitted_conclusions"],
        "properties": {
          "strength": {"$ref": "#/$defs/normativeStrength"},
          "meaning": {"type": "string", "minLength": 1},
          "may_establish_concrete_expectation": {"type": "boolean"},
          "permitted_conclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "quality_axes": {
      "type": "object", "additionalProperties": false,
      "required": ["role_is_orthogonal", "numeric_confidence_forbidden", "integrity_statuses", "preservation_statuses", "reproducibility_statuses", "rule"],
      "properties": {
        "role_is_orthogonal": {"const": true},
        "numeric_confidence_forbidden": {"const": true},
        "integrity_statuses": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["verified", "unverified", "failed"]}},
        "preservation_statuses": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["immutable-complete", "incomplete", "unavailable"]}},
        "reproducibility_statuses": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["not-applicable", "unassessed", "reproduced", "not-reproduced", "provenance-blocked"]}},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "admissibility_decision_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_states", "fail_closed", "unknown_or_incomplete_never_elevates", "scope_must_be_covered", "decision_inputs"],
      "properties": {
        "decision_states": {"const": ["admissible", "inadmissible"]},
        "fail_closed": {"const": true},
        "unknown_or_incomplete_never_elevates": {"const": true},
        "scope_must_be_covered": {"const": true},
        "decision_inputs": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "immutable_provenance_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_version_required", "content_digest_required", "stable_locator_required_when_source_based", "mutable_aliases_forbidden", "knowledge_projection_rule"],
      "properties": {
        "exact_version_required": {"const": true},
        "content_digest_required": {"const": true},
        "stable_locator_required_when_source_based": {"const": true},
        "mutable_aliases_forbidden": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "knowledge_projection_rule": {"type": "string", "minLength": 1}
      }
    },
    "authority_domain_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["wrapper_independence_forbidden", "shared_upstream_is_shared_authority", "independent_domain_count_rule", "deep_dependency_traversal_required"],
      "properties": {
        "wrapper_independence_forbidden": {"const": true},
        "shared_upstream_is_shared_authority": {"const": true},
        "independent_domain_count_rule": {"type": "string", "minLength": 1},
        "deep_dependency_traversal_required": {"const": true}
      }
    },
    "prohibitions": {
      "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["prohibition_id", "machine_rule", "statement"],
        "properties": {
          "prohibition_id": {"pattern": "^E[0-9]{2}$", "type": "string"},
          "machine_rule": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "derivation": {"$ref": "#/$defs/derivation"},
    "contract_id": {"type": "string", "pattern": "^rcid:v1:trust-policy-revision:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "contract_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "artifact_id", "digest_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"},
        "contract_version": {"type": "string", "minLength": 1},
        "requirement_count": {"type": "integer", "minimum": 0}
      }
    },
    "derivation": {
      "type": "object", "additionalProperties": false,
      "required": ["derivation_id", "derivation_revision_id", "derivation_class"],
      "properties": {
        "derivation_id": {"type": "string", "pattern": "^rcid:v1:assertion-derivation:u7:"},
        "derivation_revision_id": {"type": "string", "pattern": "^rcid:v1:assertion-derivation-revision:h:jcs-sha256-v1:"},
        "derivation_class": {"const": "manual-decision"}
      }
    },
    "evidenceRole": {"enum": ["normative-source-evidence", "formal-derivation-evidence", "authoritative-data-derived-evidence", "relational-metamorphic-evidence", "family-relative-reference-evidence", "implementation-documentation-evidence", "historical-empirical-evidence", "characterization-only-evidence"]},
    "epistemicUse": {"enum": ["establish-normative-expectation", "establish-formal-model-expectation", "establish-data-scoped-expectation", "evaluate-metamorphic-relation", "establish-family-relative-comparison", "establish-implementation-documentation-expectation", "establish-historical-fact", "establish-characterization", "support-discrepancy-investigation", "support-research-revision"]},
    "normativeStrength": {"enum": ["required", "prohibited", "permitted", "optional", "conditional", "implementation-defined", "unspecified", "informative-non-normative", "ambiguous", "silent-not-established", "not-applicable"]}
  }
}
