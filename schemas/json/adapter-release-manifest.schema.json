{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/adapter-release-manifest.schema.json",
  "title": "STRling Regex Conformance Adapter Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_release_manifest_id", "build", "certification", "identity", "identity_schema_family_id",
    "identity_schema_version", "license", "protocol", "runtime_constraints", "schema_version",
    "source_files", "supersedes"
  ],
  "properties": {
    "adapter_release_manifest_id": {
      "type": "string",
      "pattern": "^rcid:v1:adapter-release-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "dependencies", "source_revision_policy", "toolchain"],
      "properties": {
        "artifact_kind": { "const": "source-package" },
        "dependencies": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "source_revision_policy": { "const": "containing-git-commit-plus-source-digest" },
        "toolchain": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "status", "suite"],
      "properties": {
        "case_count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "status": { "const": "certified" },
        "suite": { "const": "tests/adapters" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter", "adapter_release", "capabilities", "entrypoint", "profile", "protocol_revision",
        "selection_key", "source_digest", "target_release"
      ],
      "properties": {
        "adapter": { "type": "string", "pattern": "^rcid:v1:adapter:u7:[0-9a-f-]{36}$" },
        "adapter_release": { "type": "string", "pattern": "^rcid:v1:adapter-release:u7:[0-9a-f-]{36}$" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "entrypoint": { "enum": ["adapters/python/run.py", "adapters/python/run_qualification.py"] },
        "profile": { "type": "string", "pattern": "^rcid:v1:profile:u7:[0-9a-f-]{36}$" },
        "protocol_revision": {
          "type": "string",
          "pattern": "^rcid:v1:adapter-protocol-revision:h:jcs-sha256-v1:[0-9a-f]{64}$"
        },
        "selection_key": { "enum": ["mysql-regex", "pcre2-dfa", "pcre2-ordinary", "python-re"] },
        "source_digest": { "$ref": "#/$defs/digest" },
        "target_release": { "type": "string", "pattern": "^rcid:v1:release:u7:[0-9a-f-]{36}$" }
      }
    },
    "identity_schema_family_id": {
      "const": "rcid:v1:schema-family:u7:019ffb61-586b-7d24-aa51-33d64636d741"
    },
    "identity_schema_version": { "const": "1.0.0" },
    "license": { "const": "MPL-2.0" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "maximum_minor", "minimum_minor", "schema_versions"],
      "properties": {
        "major": { "const": 1 },
        "maximum_minor": { "const": 0 },
        "minimum_minor": { "const": 0 },
        "schema_versions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.v[1-9][0-9]*$" }
        }
      }
    },
    "runtime_constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "$ref": "#/$defs/token" },
          "value": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "schema_version": { "const": "adapter-release-manifest.v1" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^adapters/python/[A-Za-z0-9_./-]+\\.py$",
            "maxLength": 256
          },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "supersedes": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^rcid:v1:adapter-release-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$" }
      ]
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "token": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96 }
  }
}
