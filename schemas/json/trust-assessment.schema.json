{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/trust-assessment.schema.json",
  "title": "Immutable Evidence Trust Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analytical_admissible", "assessed_manifest_sha256", "campaign_manifest_id", "certification_admissible",
    "classification", "disposition", "evidence_manifest_id", "findings",
    "integrity_qualification", "policy_revision", "schema_version", "summary",
    "trust_assessment_id", "trust_qualification"
  ],
  "properties": {
    "analytical_admissible": {"type": "boolean"},
    "assessed_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "campaign_manifest_id": {"type": "string", "pattern": "^rcid:v1:campaign-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "certification_admissible": {"const": false},
    "classification": {"$ref": "#/$defs/classification"},
    "disposition": {"enum": ["admitted", "quarantined", "retained-incomplete"]},
    "evidence_manifest_id": {
      "oneOf": [
        {"type": "string", "pattern": "^rcid:v1:evidence-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "findings": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/finding"}},
    "integrity_qualification": {"enum": ["failed", "passed"]},
    "policy_revision": {"const": "result-integrity-v1"},
    "schema_version": {"const": "trust-assessment.v1"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["error_count", "finding_count"],
      "properties": {
        "error_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "finding_count": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "trust_assessment_id": {"type": "string", "pattern": "^rcid:v1:trust-assessment:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "trust_qualification": {"const": "not-assessed"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "admitted"}}, "required": ["disposition"]},
      "then": {
        "properties": {
          "analytical_admissible": {"const": true},
          "findings": {"maxItems": 0},
          "integrity_qualification": {"const": "passed"}
        }
      },
      "else": {"properties": {"analytical_admissible": {"const": false}}}
    },
    {
      "if": {"properties": {"disposition": {"const": "quarantined"}}, "required": ["disposition"]},
      "then": {
        "properties": {
          "findings": {"minItems": 1, "maxItems": 1},
          "integrity_qualification": {"const": "failed"}
        }
      }
    }
  ],
  "$defs": {
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_authority", "normative_authority", "operational_qualification_only", "semantic_authority"],
      "properties": {
        "canonical_authority": {"const": false},
        "normative_authority": {"const": false},
        "operational_qualification_only": {"const": true},
        "semantic_authority": {"const": false}
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_category", "artifact_sha256", "code", "logical_execution_id", "message", "severity"],
      "properties": {
        "artifact_category": {"oneOf": [{"type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$"}, {"type": "null"}]},
        "artifact_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "code": {"type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$", "maxLength": 128},
        "logical_execution_id": {
          "oneOf": [
            {"type": "string", "pattern": "^rcid:v1:logical-execution:h:jcs-sha256-v1:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "severity": {"const": "error"}
      }
    }
  }
}
