{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/obligation-derivation-dry-run.schema.json",
  "title": "Non-authoritative obligation derivation dry run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "published_on", "classification", "semantic_authority", "rule_contract", "summary", "distribution", "feature_results", "decisions", "anomalies", "denominator_boundary", "derivation_id", "derivation_revision_id", "report_id", "report_digest_sha256"],
  "properties": {
    "schema_version": {"const": "obligation-derivation-dry-run.v1"},
    "published_on": {"type": "string", "format": "date"},
    "classification": {"type": "object", "additionalProperties": false, "required": ["analysis_only", "authoritative_denominator", "canonical_obligation_ids_minted", "production_vectors_generated", "profile_applicability_evaluated"], "properties": {"analysis_only": {"const": true}, "authoritative_denominator": {"const": false}, "canonical_obligation_ids_minted": {"const": false}, "production_vectors_generated": {"const": false}, "profile_applicability_evaluated": {"const": false}}},
    "semantic_authority": {"type": "object", "minProperties": 4},
    "rule_contract": {"type": "object", "minProperties": 3},
    "summary": {"type": "object", "additionalProperties": false, "required": ["feature_count", "facet_decisions", "provisional_obligations", "conditional_obligations", "suppressed_not_applicable_decisions", "suppressed_no_feature_implication_decisions", "blocked_decisions", "distinct_feature_shapes", "most_common_feature_shape_count"], "properties": {"feature_count": {"const": 269}, "facet_decisions": {"const": 4035}, "provisional_obligations": {"type": "integer", "minimum": 1}, "conditional_obligations": {"type": "integer", "minimum": 0}, "suppressed_not_applicable_decisions": {"type": "integer", "minimum": 0}, "suppressed_no_feature_implication_decisions": {"type": "integer", "minimum": 0}, "blocked_decisions": {"const": 0}, "distinct_feature_shapes": {"type": "integer", "minimum": 2}, "most_common_feature_shape_count": {"type": "integer", "minimum": 1, "maximum": 268}}},
    "distribution": {"type": "object", "required": ["obligations_per_feature", "by_decision", "by_requirement_state", "by_facet", "by_operation", "by_archetype", "by_question_type"], "additionalProperties": false, "properties": {"obligations_per_feature": {"type": "object", "required": ["minimum", "median", "p95", "maximum"], "additionalProperties": {"type": "integer", "minimum": 0}}, "by_decision": {"$ref": "#/$defs/countMap"}, "by_requirement_state": {"$ref": "#/$defs/countMap"}, "by_facet": {"$ref": "#/$defs/countMap"}, "by_operation": {"$ref": "#/$defs/countMap"}, "by_archetype": {"$ref": "#/$defs/countMap"}, "by_question_type": {"$ref": "#/$defs/countMap"}}},
    "feature_results": {"type": "array", "minItems": 269, "maxItems": 269, "items": {"type": "object", "required": ["feature_id", "scientific_id", "provisional_obligation_count", "shape_digest_sha256"], "properties": {"feature_id": {"type": "string", "pattern": "^feature\\."}, "scientific_id": {"type": "string", "pattern": "^rcid:v1:feature:u7:"}, "provisional_obligation_count": {"type": "integer", "minimum": 1}, "shape_digest_sha256": {"$ref": "#/$defs/digest"}}, "additionalProperties": false}},
    "decisions": {"type": "array", "minItems": 4035, "maxItems": 4035, "items": {"$ref": "#/$defs/decision"}},
    "anomalies": {"type": "array", "items": {"type": "object", "minProperties": 3}},
    "denominator_boundary": {"type": "object", "minProperties": 5},
    "derivation_id": {"type": "string", "pattern": "^rcid:v1:assertion-derivation:u7:"},
    "derivation_revision_id": {"type": "string", "pattern": "^rcid:v1:assertion-derivation-revision:h:"},
    "report_id": {"type": "string", "pattern": "^rcid:v1:ontology-projection:h:"},
    "report_digest_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "countMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["feature_id", "feature_scientific_id", "facet_id", "decision", "question_type", "governing_states", "semantic_inputs", "rule_key", "rule_revision_id", "operation_ids", "operation_scientific_ids", "operation_condition", "interaction_bases", "reason", "provisional_obligations"], "properties": {"feature_id": {"type": "string", "pattern": "^feature\\."}, "feature_scientific_id": {"type": "string", "pattern": "^rcid:v1:feature:u7:"}, "facet_id": {"type": "string", "pattern": "^facet\\."}, "decision": {"enum": ["required", "conditionally-required", "not-applicable", "not-required-by-feature-semantics", "blocked-by-unresolved-semantics"]}, "question_type": {"enum": ["normative/conformance-capable", "implementation-documentation-capable", "characterization-only", "relational/metamorphic-candidate", "unresolved"]}, "governing_states": {"type": "array", "minItems": 1}, "semantic_inputs": {"type": "array"}, "rule_key": {"type": "string"}, "rule_revision_id": {"type": "string", "pattern": "^rcid:v1:applicability-rule-set:h:"}, "operation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^operation\\."}}, "operation_scientific_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^rcid:v1:operation:u7:"}}, "operation_condition": {"type": "object"}, "interaction_bases": {"type": "array"}, "reason": {"type": "string", "minLength": 1}, "provisional_obligations": {"type": "array", "items": {"type": "object", "required": ["analysis_key", "archetype_id", "question_type", "requirement_state", "operation_ids", "operation_scientific_ids", "profile_condition", "interaction_basis", "semantic_variant_basis", "prospective_identity_basis"], "properties": {"analysis_key": {"type": "string", "pattern": "^analysis-obligation\\."}, "archetype_id": {"type": "string", "pattern": "^archetype\\."}, "question_type": {"type": "string"}, "requirement_state": {"enum": ["required", "conditionally-required"]}, "operation_ids": {"type": "array"}, "operation_scientific_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^rcid:v1:operation:u7:"}}, "profile_condition": {"type": "object"}, "interaction_basis": {"type": ["object", "null"]}, "semantic_variant_basis": {"type": ["object", "null"]}, "prospective_identity_basis": {"type": "object"}}, "additionalProperties": false}}}}
  }
}
