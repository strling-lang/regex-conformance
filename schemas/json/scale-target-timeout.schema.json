{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/scale-target-timeout.schema.json",
  "title": "Scale Target Timeout Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_release_manifest_id", "canonical_authority", "logical_execution_id",
    "outcome", "process_execution", "profile_id", "runtime_identity",
    "schema_version", "semantic_authority", "target_release_id", "timer",
    "trace_reference"
  ],
  "properties": {
    "adapter_release_manifest_id": {"type": "string", "pattern": "^rcid:v1:adapter-release-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "canonical_authority": {"const": false},
    "logical_execution_id": {"type": "string", "pattern": "^rcid:v1:logical-execution:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "outcome": {"const": "target-timeout"},
    "process_execution": {"$ref": "#/$defs/process"},
    "profile_id": {"type": "string", "pattern": "^rcid:v1:profile:u7:[0-9a-f-]{36}$"},
    "runtime_identity": {
      "type": "object", "additionalProperties": false, "required": ["facts"],
      "properties": {
        "facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/fact"}}
      }
    },
    "schema_version": {"const": "scale-target-timeout.v1"},
    "semantic_authority": {"const": false},
    "target_release_id": {"type": "string", "pattern": "^rcid:v1:release:u7:[0-9a-f-]{36}$"},
    "timer": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "wall_time_ms"],
      "properties": {
        "implementation": {"const": "posix-itimer-real"},
        "wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "trace_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fact": {
      "type": "object", "additionalProperties": false, "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "process": {
      "type": "object", "additionalProperties": false,
      "required": [
        "canonical_authority", "diagnostic", "exit_code", "outcome",
        "provider_plan", "semantic_authority", "stderr_sha256",
        "stderr_total_bytes", "stdout_sha256", "stdout_total_bytes", "wall_time_ms"
      ],
      "properties": {
        "canonical_authority": {"const": false},
        "diagnostic": {"type": ["string", "null"]},
        "exit_code": {"const": 0},
        "outcome": {"const": "completed"},
        "provider_plan": {"type": "object"},
        "semantic_authority": {"const": false},
        "stderr_sha256": {"$ref": "#/$defs/digest"},
        "stderr_total_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/digest"},
        "stdout_total_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "wall_time_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
