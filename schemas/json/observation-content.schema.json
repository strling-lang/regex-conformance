{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/observation-content.schema.json",
  "title": "Immutable Empirical Observation Content v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_manifest_id", "logical_execution_id", "observation_content_id",
    "observation_id", "physical_run_id", "provenance", "response", "schema_version"
  ],
  "properties": {
    "campaign_manifest_id": {"$ref": "#/$defs/campaign"},
    "logical_execution_id": {"$ref": "#/$defs/logical"},
    "observation_content_id": {"$ref": "#/$defs/content"},
    "observation_id": {"$ref": "#/$defs/observation"},
    "physical_run_id": {"$ref": "#/$defs/physical"},
    "provenance": {"type": "object"},
    "response": {"type": "object"},
    "schema_version": {"const": "observation-content.v1"}
  },
  "$defs": {
    "campaign": {"type": "string", "pattern": "^rcid:v1:campaign-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "content": {"type": "string", "pattern": "^rcid:v1:observation-content:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "logical": {"type": "string", "pattern": "^rcid:v1:logical-execution:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "observation": {"type": "string", "pattern": "^rcid:v1:observation:u7:[0-9a-f-]{36}$"},
    "physical": {"type": "string", "pattern": "^rcid:v1:physical-run:u7:[0-9a-f-]{36}$"}
  }
}
