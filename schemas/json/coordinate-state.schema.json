{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/coordinate-state.schema.json",
  "title": "Derived coordinate state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinate_id", "scientific_state", "coordinate_state", "operational_state", "gate_state", "gate_id", "reason_codes", "derivation_inputs"],
  "properties": {
    "schema_version": {"const": "coordinate-state.v1"},
    "coordinate_id": {"type": "string", "pattern": "^rcid:v1:applicability-coordinate:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "scientific_state": {"enum": ["not-applicable", "applicability-unresolved", "applicability-invalid", "not-tested", "unobserved", "inconclusive", "satisfied", "violated", "permitted-divergence", "conflicting-evidence", "conflicting-authority"]},
    "coordinate_state": {"enum": ["not-applicable", "applicability-unresolved", "applicability-invalid", "not-tested", "unobserved", "inconclusive", "satisfied", "violated", "permitted-divergence", "conflicting-evidence", "conflicting-authority", "quarantined", "waived-for-gate"]},
    "operational_state": {"enum": ["normal", "quarantined"]},
    "gate_state": {"enum": ["unaffected", "waived", "blocked-by-quarantine"]},
    "gate_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[-_.][A-Za-z0-9]+)*$"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "derivation_inputs": {"type": "object"}
  }
}
