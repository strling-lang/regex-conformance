{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/adjudication-authority.schema.json",
  "title": "Current adjudication authority index",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "published_on", "current_contract", "predecessors", "validation_fixture", "acceptance_report", "historical_compatibility", "production_boundary", "governance", "index_id", "index_digest_sha256"],
  "properties": {
    "schema_version": {"const": "adjudication-authority.v1"},
    "published_on": {"type": "string", "format": "date"},
    "current_contract": {"type": "object"},
    "predecessors": {"type": "object"},
    "validation_fixture": {"type": "object"},
    "acceptance_report": {"type": "object"},
    "historical_compatibility": {"type": "object"},
    "production_boundary": {"type": "object"},
    "governance": {"type": "object"},
    "index_id": {"type": "string", "pattern": "^rcid:v1:artifact-set-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "index_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
