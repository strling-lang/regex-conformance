{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/execution-lineage-set.schema.json",
  "title": "Execution Lineage Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_manifest_id",
    "count_derivation_revision_id",
    "counts",
    "execution_policy_revision_sha256",
    "lineage_set_sha256",
    "lineages",
    "schema_version"
  ],
  "properties": {
    "campaign_manifest_id": {"type": "string", "pattern": "^rcid:v1:campaign-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "count_derivation_revision_id": {"type": "string", "pattern": "^rcid:v1:assertion-derivation-revision:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inconclusive_attempt_count",
        "logical_execution_count",
        "physical_attempt_count",
        "recovered_attempt_count",
        "repeat_measurement_attempt_count",
        "retry_attempt_count",
        "terminal_attempt_count",
        "terminal_observation_count"
      ],
      "properties": {
        "inconclusive_attempt_count": {"type": "integer", "minimum": 0},
        "logical_execution_count": {"type": "integer", "minimum": 1},
        "physical_attempt_count": {"type": "integer", "minimum": 1},
        "recovered_attempt_count": {"type": "integer", "minimum": 0},
        "repeat_measurement_attempt_count": {"type": "integer", "minimum": 0},
        "retry_attempt_count": {"type": "integer", "minimum": 0},
        "terminal_attempt_count": {"type": "integer", "minimum": 0},
        "terminal_observation_count": {"type": "integer", "minimum": 0}
      }
    },
    "execution_policy_revision_sha256": {"$ref": "#/$defs/digest"},
    "lineage_set_sha256": {"$ref": "#/$defs/digest"},
    "lineages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempts", "disposition", "logical_execution_id", "observations"],
        "properties": {
          "attempts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "disposition": {"type": "object"},
          "logical_execution_id": {"type": "string", "pattern": "^rcid:v1:logical-execution:h:jcs-sha256-v1:[0-9a-f]{64}$"},
          "observations": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "schema_version": {"const": "execution-lineage-set.v1"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
