{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/scale-warehouse-reconciliation.schema.json",
  "title": "P19 Scale Warehouse Reconciliation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign", "classification", "evidence", "reconciliation", "recovery",
    "schema_version", "source_digests", "warehouse"
  ],
  "properties": {
    "campaign": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_manifest_id", "logical_plan_sha256"],
      "properties": {
        "campaign_manifest_id": {"$ref": "#/$defs/campaign"},
        "logical_plan_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": [
        "canonical_authority", "docker_used", "external_source_evidence_mutated",
        "normative_authority", "operational_reconciliation_only",
        "semantic_authority", "target_execution_performed"
      ],
      "properties": {
        "canonical_authority": {"const": false},
        "docker_used": {"const": false},
        "external_source_evidence_mutated": {"const": false},
        "normative_authority": {"const": false},
        "operational_reconciliation_only": {"const": true},
        "semantic_authority": {"const": false},
        "target_execution_performed": {"const": false}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "evidence_manifest_id", "evidence_manifest_sha256",
        "evidence_manifest_size_bytes", "evidence_root_digest",
        "execution_report_sha256"
      ],
      "properties": {
        "evidence_manifest_id": {"$ref": "#/$defs/evidenceManifest"},
        "evidence_manifest_sha256": {"$ref": "#/$defs/digest"},
        "evidence_manifest_size_bytes": {"type": "integer", "minimum": 1},
        "evidence_root_digest": {"$ref": "#/$defs/digest"},
        "execution_report_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "attempt_only_segments", "commitments", "counts", "invariants",
        "reconciliation_digest", "selection_summary"
      ],
      "properties": {
        "attempt_only_segments": {
          "type": "array", "items": {"$ref": "#/$defs/attemptOnly"}
        },
        "commitments": {"$ref": "#/$defs/commitments"},
        "counts": {"$ref": "#/$defs/counts"},
        "invariants": {
          "type": "object", "additionalProperties": false,
          "required": [
            "all_planned_interruptions_match", "evidence_and_report_identities_match",
            "evidence_objects_are_exactly_manifested",
            "infrastructure_failures_are_non_crediting", "logical_denominator_is_exact",
            "no_duplicate_logical_completion", "observation_content_identities_match",
            "recovery_ledger_hash_chain_matches", "retry_ordinals_are_contiguous",
            "warehouse_rows_match_immutable_evidence"
          ],
          "properties": {
            "all_planned_interruptions_match": {"const": true},
            "evidence_and_report_identities_match": {"const": true},
            "evidence_objects_are_exactly_manifested": {"const": true},
            "infrastructure_failures_are_non_crediting": {"const": true},
            "logical_denominator_is_exact": {"const": true},
            "no_duplicate_logical_completion": {"const": true},
            "observation_content_identities_match": {"const": true},
            "recovery_ledger_hash_chain_matches": {"const": true},
            "retry_ordinals_are_contiguous": {"const": true},
            "warehouse_rows_match_immutable_evidence": {"const": true}
          }
        },
        "reconciliation_digest": {"$ref": "#/$defs/digest"},
        "selection_summary": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "infrastructure_failures", "logical_executions", "physical_attempts",
              "selected_observations", "selection_key"
            ],
            "properties": {
              "infrastructure_failures": {"type": "integer", "minimum": 0},
              "logical_executions": {"type": "integer", "minimum": 1},
              "physical_attempts": {"type": "integer", "minimum": 1},
              "selected_observations": {"type": "integer", "minimum": 1},
              "selection_key": {"$ref": "#/$defs/token"}
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": [
        "commit_count", "completed_session", "hash_chain_tail", "ledger_sha256",
        "session_summary"
      ],
      "properties": {
        "commit_count": {"type": "integer", "minimum": 1},
        "completed_session": {
          "type": "object", "additionalProperties": false,
          "required": ["ended_at", "session_id", "started_at"],
          "properties": {
            "ended_at": {"type": "string", "format": "date-time"},
            "session_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
            "started_at": {"type": "string", "format": "date-time"}
          }
        },
        "hash_chain_tail": {"$ref": "#/$defs/digest"},
        "ledger_sha256": {"$ref": "#/$defs/digest"},
        "session_summary": {
          "type": "object", "additionalProperties": false,
          "required": ["active", "completed", "failed", "forced_interruption", "total"],
          "properties": {
            "active": {"const": 0},
            "completed": {"type": "integer", "minimum": 1},
            "failed": {"type": "integer", "minimum": 0},
            "forced_interruption": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "schema_version": {"const": "scale-warehouse-reconciliation.v1"},
    "source_digests": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "warehouse": {
      "type": "object", "additionalProperties": false,
      "required": [
        "counts", "row_commitments", "schema_sha256", "warehouse_build_id",
        "warehouse_filename", "warehouse_sha256"
      ],
      "properties": {
        "counts": {"$ref": "#/$defs/counts"},
        "row_commitments": {"$ref": "#/$defs/commitments"},
        "schema_sha256": {"$ref": "#/$defs/digest"},
        "warehouse_build_id": {"type": "string", "pattern": "^rcid:v1:artifact-set-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
        "warehouse_filename": {"type": "string", "pattern": "^scale-warehouse-[0-9a-f]{64}\\.sqlite$"},
        "warehouse_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "attemptOnly": {
      "type": "object", "additionalProperties": false,
      "required": [
        "attempt_count", "attempt_number", "cause", "failure_code",
        "failure_message_sha256", "ledger_commit_ordinal", "logical_execution_count",
        "observation_count", "recovery_attempt_number", "recovery_observation_count",
        "recovery_segment_sha256", "result_segment_id", "segment_sha256",
        "selection_key", "shard_id"
      ],
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 1},
        "attempt_number": {"type": "integer", "minimum": 1},
        "cause": {"enum": [
          "isolated-cpython-outer-wall-time-limit-exit-minus-15",
          "other-infrastructure-failure", "planned-forced-worker-kill"
        ]},
        "failure_code": {"$ref": "#/$defs/token"},
        "failure_message_sha256": {"$ref": "#/$defs/digest"},
        "ledger_commit_ordinal": {"type": "integer", "minimum": 1},
        "logical_execution_count": {"type": "integer", "minimum": 1},
        "observation_count": {"const": 0},
        "recovery_attempt_number": {"type": "integer", "minimum": 1},
        "recovery_observation_count": {"type": "integer", "minimum": 1},
        "recovery_segment_sha256": {"$ref": "#/$defs/digest"},
        "result_segment_id": {"type": "string", "pattern": "^rcid:v1:result-segment:h:jcs-sha256-v1:[0-9a-f]{64}$"},
        "segment_sha256": {"$ref": "#/$defs/digest"},
        "selection_key": {"$ref": "#/$defs/token"},
        "shard_id": {"type": "string", "pattern": "^rcid:v1:shard:h:jcs-sha256-v1:[0-9a-f]{64}$"}
      }
    },
    "campaign": {"type": "string", "pattern": "^rcid:v1:campaign-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "commitments": {
      "type": "object", "additionalProperties": false,
      "required": [
        "logical_execution_ids_sha256", "observation_content_ids_sha256",
        "physical_run_ids_sha256", "result_segment_sha256s_sha256"
      ],
      "properties": {
        "logical_execution_ids_sha256": {"$ref": "#/$defs/digest"},
        "observation_content_ids_sha256": {"$ref": "#/$defs/digest"},
        "physical_run_ids_sha256": {"$ref": "#/$defs/digest"},
        "result_segment_sha256s_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "campaigns", "interruptions", "logical_executions", "physical_attempts",
        "result_segments", "selected_observations", "shards"
      ],
      "properties": {
        "campaigns": {"const": 1},
        "interruptions": {"type": "integer", "minimum": 1},
        "logical_executions": {"type": "integer", "minimum": 1},
        "physical_attempts": {"type": "integer", "minimum": 1},
        "result_segments": {"type": "integer", "minimum": 1},
        "selected_observations": {"type": "integer", "minimum": 1},
        "shards": {"type": "integer", "minimum": 1}
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceManifest": {"type": "string", "pattern": "^rcid:v1:evidence-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128}
  }
}
