{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/scale-execution-report.schema.json",
  "title": "100K Scale Execution Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_observation_count", "attempt_count", "campaign_manifest_id",
    "evidence_manifest_id", "evidence_manifest_reference",
    "infrastructure_failure_attempt_count", "interruption_count",
    "logical_execution_count", "reconciliation", "result_shard_count",
    "schema_version", "session_summary", "trust_class"
  ],
  "properties": {
    "accepted_observation_count": {"const": 100000},
    "attempt_count": {"type": "integer", "minimum": 100000},
    "campaign_manifest_id": {"type": "string", "pattern": "^rcid:v1:campaign-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "evidence_manifest_id": {"type": "string", "pattern": "^rcid:v1:evidence-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "evidence_manifest_reference": {"$ref": "#/$defs/reference"},
    "infrastructure_failure_attempt_count": {"type": "integer", "minimum": 1},
    "interruption_count": {"const": 3},
    "logical_execution_count": {"const": 100000},
    "reconciliation": {"const": "exact"},
    "result_shard_count": {"const": 402},
    "schema_version": {"const": "scale-execution-report.v1"},
    "session_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["active", "completed", "failed", "forced_interruption", "total"],
      "properties": {
        "active": {"type": "integer", "minimum": 0},
        "completed": {"const": 1},
        "failed": {"type": "integer", "minimum": 0},
        "forced_interruption": {"const": 3},
        "total": {"type": "integer", "minimum": 4}
      }
    },
    "trust_class": {"enum": ["development", "trusted_executioner"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "category": {"const": "scale-manifests"},
        "relative_path": {"type": "string", "pattern": "^scale-manifests/sha256/[0-9a-f]{64}\\.json$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
