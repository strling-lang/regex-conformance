{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/qualification-coverage-report.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "campaign_manifest_id", "classification", "profile_coordinate_count", "selection_keys", "added_profile_keys", "vector_count", "candidate_count", "included_count", "excluded_count", "unresolved_count", "invalid_count", "categories"],
  "properties": {
    "schema_version": {"const": "qualification-coverage-report.v1"},
    "campaign_manifest_id": {"type": "string", "pattern": "^rcid:v1:campaign-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["normative_authority", "operational_qualification_only", "semantic_authority"],
      "properties": {"normative_authority": {"const": false}, "operational_qualification_only": {"const": true}, "semantic_authority": {"const": false}}
    },
    "profile_coordinate_count": {"type": "integer", "minimum": 4},
    "selection_keys": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "added_profile_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "vector_count": {"type": "integer", "minimum": 8},
    "candidate_count": {"type": "integer", "minimum": 1},
    "included_count": {"type": "integer", "minimum": 1},
    "excluded_count": {"type": "integer", "minimum": 0},
    "unresolved_count": {"const": 0},
    "invalid_count": {"const": 0},
    "categories": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "logical_execution_count", "selection_keys", "vector_keys"],
        "properties": {
          "category": {"enum": ["capture", "error", "iteration", "profile-differential", "rejection", "replacement", "success", "timeout", "unicode"]},
          "logical_execution_count": {"type": "integer", "minimum": 1},
          "selection_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
          "vector_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
        }
      }
    }
  },
  "$defs": {"token": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
}
