{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/compiled-campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_definition_id", "campaign_definition_revision_id", "campaign_id",
    "campaign_manifest_id", "classification", "source_digests", "applicability_policy_id",
    "matrix_id", "exclusion_ledger_id", "candidates", "logical_executions", "shards",
    "denominator", "campaign_manifest"
  ],
  "properties": {
    "schema_version": { "const": "compiled-campaign.v1" },
    "campaign_definition_id": { "$ref": "#/$defs/rcid" },
    "campaign_definition_revision_id": { "$ref": "#/$defs/rcid" },
    "campaign_id": { "$ref": "#/$defs/rcid" },
    "campaign_manifest_id": { "$ref": "#/$defs/rcid" },
    "classification": { "type": "object" },
    "source_digests": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
    "applicability_policy_id": { "$ref": "#/$defs/rcid" },
    "matrix_id": { "$ref": "#/$defs/rcid" },
    "exclusion_ledger_id": { "$ref": "#/$defs/rcid" },
    "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate" } },
    "logical_executions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/logical" } },
    "shards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shard" } },
    "denominator": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "excluded_count", "included_count", "invalid_count", "unresolved_count"],
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 1 },
        "excluded_count": { "type": "integer", "minimum": 0 },
        "included_count": { "type": "integer", "minimum": 1 },
        "invalid_count": { "const": 0 },
        "unresolved_count": { "const": 0 }
      }
    },
    "campaign_manifest": { "type": "object" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rcid": { "type": "string", "pattern": "^rcid:v1:[a-z0-9]+(?:-[a-z0-9]+)*:(?:u7:[0-9a-f-]{36}|h:jcs-sha256-v1:[0-9a-f]{64})$" },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["applicability", "candidate_key", "proof", "profile_id", "selection_key", "vector_revision_id"],
      "properties": {
        "applicability": { "enum": ["excluded", "included"] },
        "candidate_key": { "type": "string" },
        "proof": { "type": "object" },
        "profile_id": { "$ref": "#/$defs/rcid" },
        "selection_key": { "type": "string" },
        "vector_revision_id": { "$ref": "#/$defs/rcid" }
      }
    },
    "logical": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_execution_id", "selection_key", "profile_id", "target_release_id", "vector_revision_id", "request"],
      "properties": {
        "logical_execution_id": { "$ref": "#/$defs/rcid" },
        "selection_key": { "type": "string" },
        "profile_id": { "$ref": "#/$defs/rcid" },
        "target_release_id": { "$ref": "#/$defs/rcid" },
        "vector_revision_id": { "$ref": "#/$defs/rcid" },
        "request": { "type": "object" }
      }
    },
    "shard": {
      "type": "object", "additionalProperties": false,
      "required": ["shard_id", "selection_key", "logical_execution_ids"],
      "properties": {
        "shard_id": { "$ref": "#/$defs/rcid" },
        "selection_key": { "type": "string" },
        "logical_execution_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rcid" } }
      }
    }
  }
}
