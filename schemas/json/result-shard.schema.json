{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/result-shard.schema.json",
  "title": "Immutable Result Shard v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_manifest_id", "complete", "observation_content_ids", "physical_run_ids",
    "planned_logical_execution_ids", "result_shard_id", "schema_version", "shard_id"
  ],
  "properties": {
    "campaign_manifest_id": {"$ref": "#/$defs/campaign"},
    "complete": {"type": "boolean"},
    "observation_content_ids": {
      "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/observation-content"}
    },
    "physical_run_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/physical"}
    },
    "planned_logical_execution_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/logical"}
    },
    "result_shard_id": {"$ref": "#/$defs/result-shard"},
    "schema_version": {"const": "result-shard.v1"},
    "shard_id": {"$ref": "#/$defs/shard"}
  },
  "$defs": {
    "campaign": {"type": "string", "pattern": "^rcid:v1:campaign-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "logical": {"type": "string", "pattern": "^rcid:v1:logical-execution:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "observation-content": {"type": "string", "pattern": "^rcid:v1:observation-content:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "physical": {"type": "string", "pattern": "^rcid:v1:physical-run:u7:[0-9a-f-]{36}$"},
    "result-shard": {"type": "string", "pattern": "^rcid:v1:result-shard:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "shard": {"type": "string", "pattern": "^rcid:v1:shard:h:jcs-sha256-v1:[0-9a-f]{64}$"}
  }
}
