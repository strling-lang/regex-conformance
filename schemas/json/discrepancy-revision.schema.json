{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/discrepancy-revision.schema.json",
  "title": "Discrepancy and divergence revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "discrepancy_id", "revision_number", "supersedes_revision_id", "relationship", "scope", "claimants", "claimants_digest_sha256", "supporting_evidence", "classification", "adjudication_state", "reviewer", "resolution_method", "permitted_divergence", "history_preserved", "recorded_on", "revision_id", "revision_digest_sha256"],
  "properties": {
    "schema_version": {"const": "discrepancy-revision.v1"},
    "discrepancy_id": {"type": "string", "pattern": "^rcid:v1:discrepancy:u7:[0-9a-f-]{36}$"},
    "revision_number": {"type": "integer", "minimum": 1},
    "supersedes_revision_id": {"oneOf": [{"type": "string", "pattern": "^rcid:v1:finding-revision:h:jcs-sha256-v1:"}, {"type": "null"}]},
    "relationship": {"enum": ["specification-vs-implementation-documentation", "specification-expectation-vs-observation", "formal-derivation-vs-observation", "authoritative-data-vs-observation", "implementation-documentation-vs-implementation", "observation-vs-observation", "historical-vs-later-behavior", "specification-vs-formal-derivation"]},
    "scope": {"type": "object"},
    "claimants": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["claimant_id", "claimant_revision_id", "claimant_digest_sha256", "claimant_kind"], "properties": {"claimant_id": {"type": "string", "minLength": 1}, "claimant_revision_id": {"type": "string", "minLength": 1}, "claimant_digest_sha256": {"$ref": "#/$defs/digest"}, "claimant_kind": {"enum": ["specification", "expectation", "formal-derivation", "authoritative-dataset", "implementation-documentation", "observation", "historical-observation", "later-observation"]}}}},
    "claimants_digest_sha256": {"$ref": "#/$defs/digest"},
    "supporting_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "classification": {"enum": ["implementation-defect", "specification-defect", "specification-ambiguity", "documentation-defect", "vector-test-defect", "harness-defect", "environment-defect", "data-version-source-mismatch", "permitted-variation", "profile-dialect-difference", "historical-regression-change", "unresolved-conflict"]},
    "adjudication_state": {"enum": ["unresolved", "reviewed-unresolved", "resolved", "superseded"]},
    "reviewer": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["reviewer_id", "reviewed_on"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "reviewed_on": {"type": "string", "format": "date"}}}, {"type": "null"}]},
    "resolution_method": {"enum": ["none", "authority-and-evidence-review", "corrected-source-revision", "majority-vote", "implementation-popularity", "delete-claimant"]},
    "permitted_divergence": {"oneOf": [{"$ref": "#/$defs/divergence"}, {"type": "null"}]},
    "history_preserved": {"const": true},
    "recorded_on": {"type": "string", "format": "date"},
    "revision_id": {"type": "string", "pattern": "^rcid:v1:finding-revision:h:jcs-sha256-v1:[0-9a-f]{64}$"},
    "revision_digest_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "divergence": {"type": "object", "additionalProperties": false, "required": ["positively_established", "normative_strength", "basis_kind", "authority_evidence_refs", "allowed_outcomes"], "properties": {"positively_established": {"type": "boolean"}, "normative_strength": {"type": "string"}, "basis_kind": {"enum": ["normative-authority", "implementation-documentation", "profile-dialect-authority", "majority-behavior", "historical-stability", "repeated-observations", "waiver", "silence"]}, "authority_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "allowed_outcomes": {"type": "object"}}}
  }
}
