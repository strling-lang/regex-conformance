{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strling.org/regex-conformance/adapter-request.schema.json",
  "title": "STRling Regex Conformance Adapter Execute Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_release_manifest_id", "callback_fixture", "correlation_id", "environment_inputs",
    "initial_state", "limits", "message_type", "operation", "options", "pattern", "profile_id",
    "replacement", "requested_observations", "schema_version", "subjects", "target_release_id",
    "trace_reference"
  ],
  "properties": {
    "adapter_release_manifest_id": { "$ref": "#/$defs/manifest_id" },
    "callback_fixture": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture_id", "parameters"],
          "properties": {
            "fixture_id": { "$ref": "#/$defs/token" },
            "parameters": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/named_value" }
            }
          }
        }
      ]
    },
    "correlation_id": { "$ref": "#/$defs/correlation" },
    "environment_inputs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/named_value" }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence", "start_offset"],
      "properties": {
        "occurrence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "start_offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_diagnostic_bytes", "maximum_matches", "maximum_output_bytes", "wall_time_ms"],
      "properties": {
        "maximum_diagnostic_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maximum_matches": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximum_output_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "wall_time_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    },
    "message_type": { "const": "execute" },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "enum": [
            "callback-replacement", "capture-extraction", "compile", "find-all", "full-match",
            "next-match", "replace-all", "replace-once", "search", "split", "test"
          ]
        },
        "version": { "const": "1.0.0" }
      }
    },
    "options": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/named_value" }
    },
    "pattern": { "$ref": "#/$defs/datum" },
    "profile_id": { "type": "string", "pattern": "^rcid:v1:profile:u7:[0-9a-f-]{36}$" },
    "replacement": { "oneOf": [{ "$ref": "#/$defs/datum" }, { "type": "null" }] },
    "requested_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "capture-history", "captures", "compile-diagnostics", "cursor", "match-state",
          "native-errors", "replacement-output", "runtime-identity", "spans", "split-output"
        ]
      }
    },
    "schema_version": { "const": "adapter-request.v1" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/datum" }
    },
    "target_release_id": { "type": "string", "pattern": "^rcid:v1:release:u7:[0-9a-f-]{36}$" },
    "trace_reference": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" }
      ]
    }
  },
  "$defs": {
    "base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
    "correlation": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "datum": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["data", "domain", "encoding", "endianness", "unit_width_bits"],
          "properties": {
            "data": { "$ref": "#/$defs/base64url" },
            "domain": { "const": "octets" },
            "encoding": { "type": "null" },
            "endianness": { "type": "null" },
            "unit_width_bits": { "const": 8 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "encoding", "endianness", "text", "unit_width_bits"],
          "properties": {
            "domain": { "const": "unicode-scalars" },
            "encoding": { "const": "unicode-scalar-values" },
            "endianness": { "type": "null" },
            "text": { "type": "string", "maxLength": 4194304 },
            "unit_width_bits": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "encoding", "endianness", "unit_width_bits", "units"],
          "properties": {
            "domain": { "const": "code-units" },
            "encoding": { "enum": ["utf-16", "utf-32"] },
            "endianness": { "enum": ["big", "little"] },
            "unit_width_bits": { "enum": [16, 32] },
            "units": {
              "type": "array",
              "maxItems": 4194304,
              "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
            }
          }
        }
      ]
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^rcid:v1:adapter-release-manifest:h:jcs-sha256-v1:[0-9a-f]{64}$"
    },
    "named_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/token" },
        "value": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            { "type": "string", "maxLength": 4096 },
            { "type": "null" }
          ]
        }
      }
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    }
  }
}
